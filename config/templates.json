  {
    "Id": "kubernetes-local-dev",
    "Name": "Kubernetes Local Development",
    "Category": "CloudNative",
    "Description": "Install local Kubernetes tooling with selectable cluster mode.",
    "Icon": "Server24",
    "InstallMode": "Scripted",
    "ScenarioTags": ["kubernetes", "kind", "k3d", "microk8s"],
    "EstimatedDurationMinutes": 10,
    "CompatibleDistros": ["Ubuntu", "Debian"],
    "VersionOptions": [
      {
        "Key": "K8S_CLUSTER_MODE",
        "Label": "Kubernetes Cluster Mode",
        "Description": "Select the local Kubernetes cluster tool",
        "Type": "Select",
        "Required": true,
        "DefaultValue": "kind",
        "Options": [
          { "Value": "kind", "Label": "kind (Kubernetes IN Docker)" },
          { "Value": "k3d", "Label": "k3d" },
          { "Value": "microk8s", "Label": "MicroK8s" }
        ]
      }
    ],
    "DefaultSelections": {
      "K8S_CLUSTER_MODE": "kind"
    },
    "PreflightChecks": [
      {
        "Id": "microk8s-systemd",
        "Name": "Systemd status check for microk8s mode",
        "Type": "Bash",
        "Command": "command -v systemctl >/dev/null && systemctl status >/dev/null",
        "Required": true,
        "ErrorMessage": "microk8s requires systemd in WSL. Enable systemd and retry.",
        "AppliesToVariable": "K8S_CLUSTER_MODE",
        "AppliesToValue": "microk8s"
      }
    ],
    "Scripts": [
      {
        "Name": "Install Kubernetes Toolchain",
        "ScriptPath": "templates/kubernetes-local-dev/install.sh",
        "Type": "Bash",
        "Phase": "PostConfigure",
        "Order": 1,
        "TimeoutSeconds": 1500
