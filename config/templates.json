      {
        "Key": "SDK_DOTNET_CHANNEL",
        "Label": "SDK Channel",
        "Description": "Choose SDK channel for installation",
        "Required": true,
        "DefaultValue": "LTS",
        "Options": [
          { "Value": "LTS", "Label": "LTS" },
          { "Value": "STS", "Label": "STS/Current" },
          { "Value": "SpecificVersion", "Label": "Specific Version" }
        ]
      },
      {
        "Key": "SDK_DOTNET_VERSION",
        "Label": "Specific SDK Version",
        "Description": "Specify the .NET SDK version (if Specific Version is selected)",
