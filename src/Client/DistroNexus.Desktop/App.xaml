<Application x:Class="DistroNexus.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:DistroNexus.Desktop.Converters"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            <converters:FileSizeFormatter x:Key="FileSizeFormatter"/>
            <converters:InstanceStateToColorConverter x:Key="InstanceStateToColorConverter"/>
            <converters:StepToVisibilityConverter x:Key="StepToVisibilityConverter"/>
            <converters:StepToBadgeAppearanceConverter x:Key="StepToBadgeAppearance"/>
            <converters:BoolToValidationColorConverter x:Key="BoolToValidationColorConverter"/>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
