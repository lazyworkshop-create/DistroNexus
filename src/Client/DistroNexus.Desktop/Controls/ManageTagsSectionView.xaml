<UserControl x:Class="DistroNexus.Desktop.Controls.ManageTagsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources">

    <ui:CardExpander Header="{lex:Loc ManageTags_SectionTitle}"
                     Icon="{ui:SymbolIcon Symbol=Tag20}"
                     IsExpanded="False"
                     Expanded="OnExpanded">

        <StackPanel Margin="0,12,0,0">

            <!-- Loading indicator -->
            <ui:ProgressRing IsIndeterminate="True"
                             Width="24" Height="24"
                             Margin="0,0,0,12"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- No tags message -->
            <TextBlock Text="{lex:Loc ManageTags_NoTags}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,8"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Tag list -->
            <ItemsControl ItemsSource="{Binding Tags}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Select checkbox -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>

                            <!-- Tag name / rename field -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding PendingName, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Used by count -->
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{lex:Loc ManageTags_UsedBy}"/>
                                <Run Text="{Binding UsedByCount}"/>
                            </TextBlock>

                            <!-- Rename / Confirm rename button -->
                            <ui:Button Grid.Column="3"
                                       Icon="{ui:SymbolIcon Symbol=Edit20}"
                                       ToolTip="{lex:Loc ManageTags_Rename}"
                                       Appearance="Secondary"
                                       Margin="0,0,4,0"
                                       Command="{Binding DataContext.RenameTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <EventSetter Event="Click" Handler="OnStartRename"/>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Grid.Column="3"
                                       Icon="{ui:SymbolIcon Symbol=Checkmark20}"
                                       ToolTip="{lex:Loc ManageTags_Rename}"
                                       Appearance="Primary"
                                       Margin="0,0,4,0"
                                       Command="{Binding DataContext.RenameTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Delete button -->
                            <ui:Button Grid.Column="4"
                                       Icon="{ui:SymbolIcon Symbol=Delete20}"
                                       ToolTip="{lex:Loc ManageTags_Delete}"
                                       Appearance="Secondary"
                                       Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bulk delete button -->
            <ui:Button Content="{lex:Loc ManageTags_BulkDelete}"
                       Icon="{ui:SymbolIcon Symbol=DeleteDismiss20}"
                       Command="{Binding BulkDeleteCommand}"
                       Margin="0,8,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>

        </StackPanel>

    </ui:CardExpander>

</UserControl>
