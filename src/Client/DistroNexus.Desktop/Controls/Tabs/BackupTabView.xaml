<UserControl x:Class="DistroNexus.Desktop.Controls.Tabs.BackupTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="680">

            <!-- Loading indicator -->
            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,16"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Schedule Editor card -->
            <ui:Card Padding="16" Margin="0,0,0,12"
                     IsEnabled="{Binding IsFormEnabled}">
                <StackPanel>
                    <!-- Section Title -->
                    <TextBlock Text="{lex:Loc BackupTab_ScheduleTitle}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Frequency -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_Frequency}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FrequencyOptions}"
                                  SelectedItem="{Binding Frequency}"/>
                    </Grid>

                    <!-- Day of Week (Weekly only) -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding ShowDayOfWeekPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_DayOfWeek}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DaysOfWeek}"
                                  SelectedItem="{Binding SelectedDayOfWeek}"/>
                    </Grid>

                    <!-- Day of Month (Monthly only) -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding ShowDayOfMonthPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_DayOfMonth}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DaysOfMonth}"
                                  SelectedItem="{Binding SelectedDayOfMonth}"/>
                    </Grid>

                    <!-- Time of Day -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_TimeOfDay}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding BackupTimeText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="HH:mm" Width="100" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Destination folder -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_Destination}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="1" Margin="0,0,6,0"
                                    Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="C:\Backups"/>
                        <ui:Button Grid.Column="2"
                                   Content="{lex:Loc BackupTab_Browse}"
                                   Command="{Binding BrowseDestinationCommand}"/>
                    </Grid>

                    <!-- Retention count -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_RetentionCount}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:NumberBox Grid.Column="1"
                                      Value="{Binding RetentionCount}"
                                      Minimum="1" Maximum="30"
                                      Width="80" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Action buttons card -->
            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Buttons row -->
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{lex:Loc BackupTab_SaveSchedule}"
                                   Icon="{ui:SymbolIcon Symbol=Save20}"
                                   Command="{Binding SaveScheduleCommand}"
                                   IsEnabled="{Binding IsFormEnabled}"
                                   Appearance="Primary" Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc BackupTab_BackupNow}"
                                   Icon="{ui:SymbolIcon Symbol=ArrowUpload20}"
                                   Command="{Binding BackupNowCommand}"
                                   IsEnabled="{Binding IsFormEnabled}"
                                   Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc BackupTab_RemoveSchedule}"
                                   Icon="{ui:SymbolIcon Symbol=Delete20}"
                                   Command="{Binding RemoveScheduleCommand}"
                                   IsEnabled="{Binding IsFormEnabled}"
                                   Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Backup in progress indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="{lex:Loc BackupTab_BackingUp}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Backup History card -->
            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="{lex:Loc BackupTab_HistoryTitle}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding HistoryFilters}" SelectedItem="{Binding SelectedHistoryFilter}" Margin="0,0,0,8" Width="160" HorizontalAlignment="Right"/>

                    <!-- Empty state -->
                    <TextBlock Text="{lex:Loc BackupTab_NoHistory}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Visibility="{Binding BackupHistory.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}"/>

                    <!-- History grid -->
                    <DataGrid ItemsSource="{Binding BackupHistory}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              RowBackground="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                              AlternatingRowBackground="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              Visibility="{Binding BackupHistory.Count, Converter={StaticResource IntToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{lex:Loc BackupTab_Timestamp}"
                                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"
                                                Width="160"/>
                            <DataGridTextColumn Header="{lex:Loc BackupTab_FileName}"
                                                Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="{lex:Loc BackupTab_Size}"
                                                Binding="{Binding FileSizeBytes, Converter={StaticResource FileSizeFormatter}}"
                                                Width="90"/>
                            <DataGridTemplateColumn Header="{lex:Loc BackupTab_Status}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{lex:Loc BackupTab_StatusSuccess}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Text" Value="{lex:Loc BackupTab_StatusFailed}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <!-- Recovery points use Core-generated previews and never overwrite an instance. -->
            <ui:Card Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{lex:Loc Recovery_Title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding RecoveryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding RecoveryDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="2" Content="{lex:Loc Recovery_Create}" Command="{Binding CreateRecoveryPointCommand}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding RecoveryTags, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{lex:Loc Recovery_Tags}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecoveryFormats}" SelectedItem="{Binding RecoveryFormat}" Margin="0,0,12,0">
                            <ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding CanUseVhdx}" Value="False"><Setter Property="ToolTip" Value="{lex:Loc Recovery_VhdxUnavailable}"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                        </ComboBox>
                        <CheckBox Grid.Column="2" Content="{lex:Loc Recovery_StopAndRestart}" IsChecked="{Binding StopAndRestartForRecovery}"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding RecoveryPoints}" SelectedItem="{Binding SelectedRecoveryPoint}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{lex:Loc Recovery_ColumnName}" Binding="{Binding Manifest.Name}" Width="*"/>
                            <DataGridTextColumn Header="{lex:Loc Recovery_ColumnCreated}" Binding="{Binding Manifest.CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="160"/>
                            <DataGridTextColumn Header="{lex:Loc Recovery_ColumnVerification}" Binding="{Binding Verification}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button Content="{lex:Loc Recovery_Verify}" Command="{Binding VerifyRecoveryPointCommand}" Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc Recovery_Reveal}" Command="{Binding RevealRecoveryPointCommand}" Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc Recovery_Delete}" Command="{Binding DeleteRecoveryPointCommand}"/>
                    </StackPanel>
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding RecoveryTargetInstance, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{lex:Loc Recovery_TargetInstance}" Margin="0,0,8,0"/>
                        <ui:TextBox Grid.Column="1" Text="{Binding RecoveryTargetDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{lex:Loc Recovery_TargetLocation}" IsEnabled="{Binding CanManageTargetDirectory}" Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="2" Content="{lex:Loc Recovery_Restore}" Command="{Binding RestoreRecoveryPointCommand}" IsEnabled="{Binding CanRestoreSelectedRecoveryPoint}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Content="{lex:Loc Recovery_ImportInPlace}" IsChecked="{Binding RecoveryImportInPlace}" IsEnabled="{Binding CanImportInPlace}" Margin="0,0,8,0"/>
                        <CheckBox Content="{lex:Loc Recovery_Pin}" IsChecked="{Binding RecoveryPinned}" Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc Recovery_SaveNotes}" Command="{Binding SaveRecoveryNotesCommand}" Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc Recovery_Clone}" Command="{Binding CloneRecoveryPointCommand}" IsEnabled="{Binding CanRestoreSelectedRecoveryPoint}"/>
                    </StackPanel>
                    <TextBlock Text="{lex:Loc Recovery_ImportInPlaceUnmanaged}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding RecoveryImportInPlace, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="{lex:Loc Recovery_Retention}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:NumberBox Value="{Binding RecoveryRetention}" Minimum="1" Maximum="100" Width="80" Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc Recovery_ApplyRetention}" Command="{Binding ApplyRecoveryRetentionCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding RecoveryOperationStatus}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc Recovery_Cancel}" Command="{Binding CancelRecoveryOperationCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding RecoveryDiagnosticDetails.Length, Converter={StaticResource IntToVisibilityConverter}}">
                        <TextBlock Text="{Binding RecoveryDiagnosticDetails}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                        <ui:Button Content="{lex:Loc Recovery_CopyDiagnostic}" Command="{Binding CopyRecoveryDiagnosticCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>

