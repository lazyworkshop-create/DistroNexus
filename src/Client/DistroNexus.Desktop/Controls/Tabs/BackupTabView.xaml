<UserControl x:Class="DistroNexus.Desktop.Controls.Tabs.BackupTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="680">

            <!-- Loading indicator -->
            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,16"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Schedule Editor card -->
            <ui:Card Padding="16" Margin="0,0,0,12"
                     IsEnabled="{Binding IsFormEnabled}">
                <StackPanel>
                    <!-- Section Title -->
                    <TextBlock Text="{lex:Loc BackupTab_ScheduleTitle}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Frequency -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_Frequency}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FrequencyOptions}"
                                  SelectedItem="{Binding Frequency}"/>
                    </Grid>

                    <!-- Day of Week (Weekly only) -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding ShowDayOfWeekPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_DayOfWeek}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DaysOfWeek}"
                                  SelectedItem="{Binding SelectedDayOfWeek}"/>
                    </Grid>

                    <!-- Day of Month (Monthly only) -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding ShowDayOfMonthPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_DayOfMonth}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DaysOfMonth}"
                                  SelectedItem="{Binding SelectedDayOfMonth}"/>
                    </Grid>

                    <!-- Time of Day -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_TimeOfDay}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding BackupTimeText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="HH:mm" Width="100" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Destination folder -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_Destination}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="1" Margin="0,0,6,0"
                                    Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="C:\Backups"/>
                        <ui:Button Grid.Column="2"
                                   Content="{lex:Loc BackupTab_Browse}"
                                   Command="{Binding BrowseDestinationCommand}"/>
                    </Grid>

                    <!-- Retention count -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc BackupTab_RetentionCount}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:NumberBox Grid.Column="1"
                                      Value="{Binding RetentionCount}"
                                      Minimum="1" Maximum="30"
                                      Width="80" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Action buttons card -->
            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Buttons row -->
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{lex:Loc BackupTab_SaveSchedule}"
                                   Icon="{ui:SymbolIcon Symbol=Save20}"
                                   Command="{Binding SaveScheduleCommand}"
                                   IsEnabled="{Binding IsFormEnabled}"
                                   Appearance="Primary" Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc BackupTab_BackupNow}"
                                   Icon="{ui:SymbolIcon Symbol=ArrowUpload20}"
                                   Command="{Binding BackupNowCommand}"
                                   IsEnabled="{Binding IsFormEnabled}"
                                   Margin="0,0,8,0"/>
                        <ui:Button Content="{lex:Loc BackupTab_RemoveSchedule}"
                                   Icon="{ui:SymbolIcon Symbol=Delete20}"
                                   Command="{Binding RemoveScheduleCommand}"
                                   IsEnabled="{Binding IsFormEnabled}"
                                   Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Backup in progress indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="{lex:Loc BackupTab_BackingUp}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Backup History card -->
            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="{lex:Loc BackupTab_HistoryTitle}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <!-- Empty state -->
                    <TextBlock Text="{lex:Loc BackupTab_NoHistory}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Visibility="{Binding BackupHistory.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}"/>

                    <!-- History grid -->
                    <DataGrid ItemsSource="{Binding BackupHistory}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              RowBackground="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                              AlternatingRowBackground="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              Visibility="{Binding BackupHistory.Count, Converter={StaticResource IntToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{lex:Loc BackupTab_Timestamp}"
                                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"
                                                Width="160"/>
                            <DataGridTextColumn Header="{lex:Loc BackupTab_FileName}"
                                                Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="{lex:Loc BackupTab_Size}"
                                                Binding="{Binding FileSizeBytes, Converter={StaticResource FileSizeFormatter}}"
                                                Width="90"/>
                            <DataGridTemplateColumn Header="{lex:Loc BackupTab_Status}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{lex:Loc BackupTab_StatusSuccess}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Text" Value="{lex:Loc BackupTab_StatusFailed}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>

