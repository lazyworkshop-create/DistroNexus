<UserControl x:Class="DistroNexus.Desktop.Controls.Tabs.IntegrationsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="620">

            <!-- Loading indicator -->
            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,16"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Docker Desktop Integration section -->
            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Title row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="PlugConnected20" FontSize="20" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{lex:Loc IntegrationsTab_DockerTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- WSL v1 guard -->
                    <ui:InfoBar Title="" Message="{lex:Loc IntegrationsTab_WslV1Message}"
                                Severity="Warning" IsOpen="{Binding ShowWslV1Message}"
                                IsClosable="False" Margin="0,0,0,8"/>

                    <!-- Docker not installed -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding IsDockerInstalled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ui:SymbolIcon Symbol="Warning20" Foreground="{DynamicResource InfoBarWarningSeverityIconBackground}"
                                       Margin="0,0,6,0"/>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://www.docker.com/products/docker-desktop/" RequestNavigate="OnOpenDockerLink">
                                <TextBlock Text="{lex:Loc IntegrationsTab_DockerInstallLink}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Toggle row -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{lex:Loc IntegrationsTab_DockerTitle}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding IsDockerEnabled}"
                                         IsEnabled="{Binding IsToggleEnabled}"
                                         Command="{Binding ToggleDockerCommand}"
                                         VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Restart banner -->
                    <ui:InfoBar Title="" Message="{lex:Loc IntegrationsTab_RestartBanner}"
                                Severity="Informational"
                                IsOpen="{Binding ShowRestartBanner}"
                                Margin="0,8,0,0">
                        <ui:InfoBar.Content>
                            <ui:Button Content="{lex:Loc IntegrationsTab_Dismiss}"
                                       Appearance="Secondary" Padding="8,4" FontSize="11"
                                       Margin="0,6,0,0"
                                       Command="{Binding DismissRestartBannerCommand}"/>
                        </ui:InfoBar.Content>
                    </ui:InfoBar>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
