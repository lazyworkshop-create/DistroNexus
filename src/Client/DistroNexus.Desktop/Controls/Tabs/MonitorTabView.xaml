<UserControl x:Class="DistroNexus.Desktop.Controls.Tabs.MonitorTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lex="http://wpflocalizeextension.codeplex.com" xmlns:controls="clr-namespace:DistroNexus.Desktop.Controls" lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop" lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><TextBlock Text="{lex:Loc MonitorTab_RefreshInterval}" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding IntervalSeconds}" Width="60" Margin="8,0"/><TextBlock Text="{lex:Loc MonitorTab_Seconds}" VerticalAlignment="Center"/><ui:Button Content="{lex:Loc MonitorTab_Refresh}" Command="{Binding RefreshCommand}" Margin="12,0"/><TextBlock Text="{Binding UnavailableReason}" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,12"><TextBlock Text="{Binding CpuDisplay}"/><TextBlock Text="{Binding MemoryDisplay}"/><TextBlock Text="{Binding SwapDisplay}"/><TextBlock Text="{Binding FilesystemDisplay}"/><TextBlock Text="{Binding DiskIoDisplay}"/><TextBlock Text="{Binding NetworkDisplay}"/><TextBlock Text="{Binding VhdxDisplay}"/><TextBlock Text="{Binding ReclaimDisplay}"/></UniformGrid>
  <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="{lex:Loc MonitorTab_WarningThresholds}" VerticalAlignment="Center"/><TextBlock Text="{lex:Loc MonitorTab_Cpu}" Margin="10,0,2,0"/><TextBox Text="{Binding CpuWarningThreshold, UpdateSourceTrigger=PropertyChanged}" Width="42"/><TextBlock Text="{lex:Loc MonitorTab_Memory}" Margin="10,0,2,0"/><TextBox Text="{Binding MemoryWarningThreshold, UpdateSourceTrigger=PropertyChanged}" Width="42"/><TextBlock Text="{lex:Loc MonitorTab_Filesystem}" Margin="10,0,2,0"/><TextBox Text="{Binding FilesystemWarningThreshold, UpdateSourceTrigger=PropertyChanged}" Width="42"/><TextBlock Text="{Binding LimitsDisplay}" Margin="16,0,0,0"/></StackPanel>
  <UniformGrid Grid.Row="3" Columns="4" Margin="0,8"><controls:RollingMetricChart Samples="{Binding Samples}" Metric="CpuPercent" Stroke="DodgerBlue"/><controls:RollingMetricChart Samples="{Binding Samples}" Metric="MemoryPercent" Stroke="MediumSeaGreen"/><controls:RollingMetricChart Samples="{Binding Samples}" Metric="FilesystemPercent" Stroke="DarkOrange"/><controls:RollingMetricChart Samples="{Binding Samples}" Metric="NetworkBytesPerSecond" Stroke="MediumPurple"/></UniformGrid>
  <DataGrid Grid.Row="4" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{lex:Loc MonitorTab_Pid}" Binding="{Binding Pid}"/><DataGridTextColumn Header="{lex:Loc MonitorTab_User}" Binding="{Binding User}"/><DataGridTextColumn Header="{lex:Loc MonitorTab_Cpu}" Binding="{Binding CpuPercent}"/><DataGridTextColumn Header="{lex:Loc MonitorTab_Memory}" Binding="{Binding MemoryPercent}"/><DataGridTextColumn Header="{lex:Loc MonitorTab_Command}" Binding="{Binding Command}" Width="*"/><DataGridTextColumn Header="{lex:Loc MonitorTab_ListenPorts}" Binding="{Binding ListeningPortsDisplay}"/><DataGridTemplateColumn Header="{lex:Loc MonitorTab_Actions}"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="{lex:Loc MonitorTab_Terminate}" Command="{Binding DataContext.TerminateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="{lex:Loc MonitorTab_Kill}" Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="4,0"/><Button Content="{lex:Loc MonitorTab_LowerPriority}" Command="{Binding DataContext.ReniceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="4,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
  <DataGrid Grid.Row="5" ItemsSource="{Binding ListeningPorts}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="{lex:Loc MonitorTab_Protocol}" Binding="{Binding Protocol}"/><DataGridTextColumn Header="{lex:Loc MonitorTab_Address}" Binding="{Binding LocalAddress}" Width="*"/><DataGridTextColumn Header="{lex:Loc MonitorTab_Port}" Binding="{Binding Port}"/></DataGrid.Columns></DataGrid>
 </Grid>
</UserControl>
