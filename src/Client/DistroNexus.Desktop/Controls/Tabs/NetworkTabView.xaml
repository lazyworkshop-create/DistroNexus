<UserControl x:Class="DistroNexus.Desktop.Controls.Tabs.NetworkTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="720">

            <!-- Stopped placeholder -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowStoppedPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:SymbolIcon Symbol="PlugDisconnected20" FontSize="36"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                <TextBlock Text="{lex:Loc NetworkTab_StoppedPlaceholder}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Loading indicator -->
            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,16"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <StackPanel Visibility="{Binding ShowStoppedPlaceholder, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">

                <!-- IP address + Refresh row -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{lex:Loc Network_Mode}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedNetworkingMode}" Width="130" IsEnabled="{Binding IsNetworkingModeAvailable}"/><ui:Button Content="{lex:Loc Network_PreviewApply}" Command="{Binding PreviewAndApplyNetworkingModeCommand}" IsEnabled="{Binding IsNetworkingModeAvailable}" Margin="4,0"/></StackPanel>
                    <TextBlock Text="{Binding NetworkingModeRestartImpact}"/><TextBlock Text="{Binding NetworkingModeEvidence}" TextWrapping="Wrap"/>
                    <TextBlock Text="{lex:Loc Network_Settings}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <WrapPanel IsEnabled="{Binding IsNetworkSettingsAvailable}"><CheckBox Content="{lex:Loc Network_DnsTunneling}" IsThreeState="True" IsChecked="{Binding DnsTunnelingEnabled}"/><CheckBox Content="{lex:Loc Network_AutoProxy}" IsThreeState="True" IsChecked="{Binding AutoProxyEnabled}" Margin="8,0"/><CheckBox Content="{lex:Loc Network_Firewall}" IsThreeState="True" IsChecked="{Binding FirewallEnabled}" Margin="8,0"/><CheckBox Content="{lex:Loc Network_HostAddressLoopback}" IsThreeState="True" IsChecked="{Binding HostAddressLoopbackEnabled}" Margin="8,0"/><CheckBox Content="{lex:Loc Network_BestEffortDnsParsing}" IsThreeState="True" IsChecked="{Binding BestEffortDnsParsingEnabled}" Margin="8,0"/></WrapPanel>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsNetworkSettingsAvailable}"><TextBlock Text="{lex:Loc Network_IgnoredPorts}" VerticalAlignment="Center"/><TextBox Text="{Binding IgnoredPorts, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="4,0"/><ui:Button Content="{lex:Loc Network_PreviewApply}" Command="{Binding PreviewAndApplyNetworkSettingsCommand}" Margin="4,0"/></StackPanel>
                    <TextBlock Text="{Binding NetworkSettingsEvidence}" TextWrapping="Wrap"/>
                    <TextBlock Text="{lex:Loc Network_ConnectivityDiagnostic}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding ProbeKinds}" SelectedItem="{Binding ProbeKind}" Width="120"/><TextBox Text="{Binding ProbeHost, UpdateSourceTrigger=PropertyChanged}" Width="170"/><TextBox Text="{Binding ProbePort}" Width="70" Margin="4,0"/><ui:Button Content="{lex:Loc Network_RunProbe}" Command="{Binding RunProbeCommand}"/><ui:Button Content="{lex:Loc Network_FirewallPreview}" Command="{Binding PreviewFirewallCommand}" Margin="4,0"/></StackPanel>
                    <TextBlock Text="{Binding ProbeResult}"/><TextBlock Text="{Binding FirewallStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding CollisionStatus}" TextWrapping="Wrap"/><TextBlock Text="{lex:Loc Network_OwnedFirewallRules}" FontWeight="SemiBold"/><TextBlock Text="{Binding OwnedFirewallRules}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding FirewallRuleId, UpdateSourceTrigger=PropertyChanged}" Width="220"/><ui:Button Content="{lex:Loc Network_PreviewRemoveFirewall}" Command="{Binding PreviewRemoveFirewallCommand}" Margin="4,0"/></StackPanel><TextBlock Text="{Binding FirewallResult}" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{lex:Loc NetworkTab_InstanceIP}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding InstanceIp}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="{lex:Loc NetworkTab_Refresh}"
                               Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                               Command="{Binding RefreshNetworkCommand}"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                </Grid>

                <!-- Ports DataGrid -->
                <DataGrid ItemsSource="{Binding PortMappings}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          RowBackground="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          AlternatingRowBackground="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{lex:Loc NetworkTab_Protocol}"
                                            Binding="{Binding Protocol}" Width="60"/>
                        <DataGridTextColumn Header="{lex:Loc NetworkTab_LocalAddress}"
                                            Binding="{Binding LocalAddress}" Width="120"/>
                        <DataGridTextColumn Header="{lex:Loc Network_AddressFamily}" Binding="{Binding AddressFamily}" Width="70"/>
                        <DataGridTextColumn Header="{lex:Loc NetworkTab_Port}"
                                            Binding="{Binding Port}" Width="60"/>
                        <DataGridTextColumn Header="{lex:Loc NetworkTab_Process}"
                                            Binding="{Binding ProcessName}" Width="*"/>
                        <DataGridTextColumn Header="{lex:Loc Network_Collision}" Binding="{Binding ConflictGuidance}" Width="150"/>
                        <DataGridTemplateColumn Header="{lex:Loc NetworkTab_WindowsProxy}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="✓"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               Visibility="{Binding HasWindowsProxy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="{lex:Loc NetworkTab_Copy}"
                                               Appearance="Secondary"
                                               FontSize="11" Padding="4,2"
                                               Command="{Binding DataContext.CopyAddressCommand,
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Button Content="{lex:Loc Network_Open}" Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
