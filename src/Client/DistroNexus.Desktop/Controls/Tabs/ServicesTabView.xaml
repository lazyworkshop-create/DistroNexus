<UserControl x:Class="DistroNexus.Desktop.Controls.Tabs.ServicesTabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lex="http://wpflocalizeextension.codeplex.com"
 lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop" lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding AvailableScopes}" SelectedItem="{Binding SelectedScope}" Width="100"/><CheckBox Content="{lex:Loc ServicesTab_Running}" IsChecked="{Binding RunningOnly}" Margin="8,0"/><CheckBox Content="{lex:Loc ServicesTab_Stopped}" IsChecked="{Binding StoppedOnly}"/><CheckBox Content="{lex:Loc ServicesTab_Failed}" IsChecked="{Binding FailedOnly}"/><CheckBox Content="{lex:Loc ServicesTab_Enabled}" IsChecked="{Binding EnabledOnly}"/><CheckBox Content="{lex:Loc ServicesTab_User}" IsChecked="{Binding UserServicesOnly}"/><ui:Button Content="{lex:Loc ServicesTab_Refresh}" Command="{Binding RefreshCommand}"/><TextBlock Text="{Binding UnavailableReason}" Margin="12,0,0,0" TextWrapping="Wrap"/></StackPanel>
  <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
   <DataGridTextColumn Header="{lex:Loc ServicesTab_Name}" Binding="{Binding Name.Value}" Width="150"/><DataGridTextColumn Header="{lex:Loc ServicesTab_Description}" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="{lex:Loc ServicesTab_State}" Binding="{Binding ActiveState}" Width="90"/><DataGridTextColumn Header="{lex:Loc ServicesTab_SubState}" Binding="{Binding SubState}" Width="90"/><DataGridTextColumn Header="{lex:Loc ServicesTab_FailureState}" Binding="{Binding LoadState}" Width="90"/><DataGridTextColumn Header="{lex:Loc ServicesTab_Enabled}" Binding="{Binding EnabledState}" Width="90"/>
   <DataGridTemplateColumn Header="{lex:Loc ServicesTab_Actions}" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
    <Button Content="{lex:Loc ServicesTab_Start}" Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="{lex:Loc ServicesTab_Stop}" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="4,0"/><Button Content="{lex:Loc ServicesTab_Restart}" Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="{lex:Loc ServicesTab_Enable}" Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="{lex:Loc ServicesTab_Disable}" Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="{lex:Loc ServicesTab_Reload}" Command="{Binding DataContext.ReloadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><Button Content="{lex:Loc ServicesTab_Details}" Command="{Binding DataContext.LoadDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
   </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid>
  <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><TextBox Text="{Binding JournalSearch, UpdateSourceTrigger=PropertyChanged}" Width="150"/><TextBox Text="{Binding JournalLineLimit}" Width="70" Margin="4,0"/><ComboBox ItemsSource="{Binding JournalSeverities}" SelectedValuePath="Value" DisplayMemberPath="Display" SelectedValue="{Binding JournalSeverity}" Width="90" Margin="4,0"/><ui:Button Content="{lex:Loc ServicesTab_Journal}" Command="{Binding LoadDetailsCommand}" CommandParameter="{Binding SelectedService}"/></StackPanel><DataGrid ItemsSource="{Binding Journal}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="{lex:Loc ServicesTab_Severity}" Binding="{Binding Severity}" Width="80"/><DataGridTextColumn Header="{lex:Loc ServicesTab_Message}" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel><Button Grid.Column="1" Content="{lex:Loc ServicesTab_CopyJournal}" Command="{Binding CopyJournalCommand}"/></Grid>
 </Grid>
</UserControl>
