<UserControl x:Class="DistroNexus.Desktop.Controls.TagChipControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Single tag pill: coloured border + name + × remove button -->
    <Border CornerRadius="10"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            Padding="8,2"
            Margin="0,0,4,0"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding TagName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <Button Content="×"
                    FontSize="11"
                    Margin="4,0,0,0"
                    Padding="2,0"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Command="{Binding RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding TagName, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Border>
</UserControl>
