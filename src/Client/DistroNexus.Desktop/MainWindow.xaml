<ui:FluentWindow x:Class="DistroNexus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="DistroNexus 2.0" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" 
                     Title="DistroNexus 2.0"
                     Icon="pack://application:,,,/Resources/icon.ico"
                     ShowMaximize="True"
                     ShowMinimize="True"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <ui:Button Content="Refresh" 
                          Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                          Command="{Binding RefreshCommand}"
                          Margin="0,0,10,0"/>
                <ui:Button Content="Install New" 
                          Icon="{ui:SymbolIcon Symbol=Add20}"
                          Command="{Binding ShowInstallWizardCommand}"
                          Margin="0,0,10,0"
                          Appearance="Primary"/>
                <ui:Button Content="Package Manager" 
                          Icon="{ui:SymbolIcon Symbol=Apps20}"
                          Command="{Binding ShowPackageManagerCommand}"
                          Margin="0,0,10,0"/>
                <ui:Button Content="Settings" 
                          Icon="{ui:SymbolIcon Symbol=Settings20}"
                          Command="{Binding ShowSettingsCommand}"/>
            </StackPanel>

            <!-- Instance List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Instances}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WslInstanceViewModel}">
                            <ui:Card Margin="0,0,0,10" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Instance Info -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" 
                                                  FontSize="18" 
                                                  FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Distribution}" 
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="State: " 
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding State}" 
                                                      FontWeight="SemiBold"/>
                                            <TextBlock Text=" | " 
                                                      Margin="10,0"
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding InstallPath}" 
                                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="1" 
                                               Orientation="Horizontal" 
                                               VerticalAlignment="Center">
                                        <ui:Button Content="Start" 
                                                  Icon="{ui:SymbolIcon Symbol=Play20}"
                                                  Command="{Binding StartCommand}"
                                                  Margin="0,0,5,0"
                                                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                        <ui:Button Content="Stop" 
                                                  Icon="{ui:SymbolIcon Symbol=Stop20}"
                                                  Command="{Binding StopCommand}"
                                                  Margin="0,0,5,0"
                                                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ui:Button Content="Remove" 
                                                  Icon="{ui:SymbolIcon Symbol=Delete20}"
                                                  Command="{Binding RemoveCommand}"
                                                  Appearance="Danger"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Grid Grid.Row="1" 
                  Background="#80000000" 
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="50" Height="50"/>
                    <TextBlock Text="Loading..." 
                              Foreground="White" 
                              FontSize="16" 
                              Margin="0,10,0,0"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <ui:InfoBar Grid.Row="2" 
                    Title="{Binding StatusMessage}"
                    IsOpen="True"
                    Severity="Informational"
                    IsClosable="False"
                    Margin="0"/>
    </Grid>
</ui:FluentWindow>
