<ui:FluentWindow x:Class="DistroNexus.Desktop.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:lex="http://wpflocalizeextension.codeplex.com"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
xmlns:controls="clr-namespace:DistroNexus.Desktop.Controls"
xmlns:package="clr-namespace:DistroNexus.Core.Models;assembly=DistroNexus.Core"
mc:Ignorable="d"
Title="DistroNexus 2.0"
Height="600"
Width="900"
WindowStartupLocation="CenterScreen"
WindowBackdropType="Mica"
ExtendsContentIntoTitleBar="True"
d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="DistroNexus 2.0"
                     Icon="pack://application:,,,/Resources/icon.ico"
                     ShowMaximize="True"
                     ShowMinimize="True"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side: Main Actions (only visible on dashboard) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                           Visibility="{Binding IsOnDashboard, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:Button Content="{lex:Loc Refresh}"
                              Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                              Command="{Binding RefreshCommand}"
                              Margin="0,0,10,0"/>
                    <ui:Button Content="{lex:Loc InstallNew}"
                              Icon="{ui:SymbolIcon Symbol=Add20}"
                              Command="{Binding ShowInstallWizardCommand}"
                              Margin="0,0,10,0"
                              Appearance="Primary"/>
                    <ui:Button Content="{lex:Loc PackageManagerTitle}"
                              Icon="{ui:SymbolIcon Symbol=Apps20}"
                              Command="{Binding ShowPackageManagerCommand}"
                              Margin="0,0,10,0"/>
                    <ui:Button Content="{lex:Loc TemplatesTitle}"
                              Icon="{ui:SymbolIcon Symbol=Library20}"
                              Command="{Binding ShowTemplatesCommand}"
                              Margin="0,0,10,0"/>
                    <ui:Button Content="{lex:Loc Toolbar_ImportInstance}"
                              Icon="{ui:SymbolIcon Symbol=ArrowImport20}"
                              Command="{Binding ImportInstanceCommand}"
                              Margin="0,0,10,0"/>
                    <ui:Button Content="{lex:Loc SettingsTitle}"
                              Icon="{ui:SymbolIcon Symbol=Settings20}"
                              Command="{Binding ShowSettingsCommand}"
                              Margin="0,0,10,0"/>
                    <ui:Button Content="{lex:Loc Health_Title}"
                              Icon="{ui:SymbolIcon Symbol=HeartPulse20}"
                              Command="{Binding ShowHealthCommand}"
                              Margin="0,0,10,0"/>
                    <ui:Button Content="{lex:Loc Devices_Title}"
                              Icon="{ui:SymbolIcon Symbol=UsbPlug20}"
                              Command="{Binding ShowDevicesCommand}"
                              Margin="0,0,10,0"/>
                      <ui:Button Content="{lex:Loc Workspace_Title}"
                              Icon="{ui:SymbolIcon Symbol=Code20}"
                              Command="{Binding ShowWorkspacesCommand}"
                                Margin="0,0,10,0"/>
                      <ui:Button Content="{lex:Loc Applications_Title}"
                                Icon="{ui:SymbolIcon Symbol=Apps20}"
                                Command="{Binding ShowApplicationsCommand}"
                                IsEnabled="{Binding IsApplicationsNavigationAvailable}"
                                ToolTip="{Binding ApplicationsNavigationReason}"
                                AutomationProperties.Name="{lex:Loc Applications_Title}"
                                Margin="0,0,10,0"/>
                    <ToggleButton Content="{lex:Loc Toolbar_SelectMode}"
                                  IsChecked="{Binding IsMultiSelectMode}"
                                  Command="{Binding ToggleMultiSelectCommand}"/>
                </StackPanel>

                <!-- Right Side: Theme and Language Controls (always visible) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Auto-refresh indicator -->
                    <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                     Visibility="{Binding IsAutoRefreshing, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,0,8,0"/>
                    <ui:Button ToolTip="{lex:Loc ToggleThemeTooltip}"
                              Icon="{ui:SymbolIcon Symbol=WeatherMoon20}"
                              Command="{Binding ToggleThemeCommand}"
                              Margin="0,0,5,0"/>

                    <ui:Button ToolTip="{lex:Loc SwitchLanguageTooltip}"
                              Icon="{ui:SymbolIcon Symbol=LocalLanguage20}"
                              Command="{Binding ToggleLanguageCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Dashboard View (Instance List) -->
            <Grid Grid.Column="0" Grid.Row="1" Visibility="{Binding IsOnDashboard, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Inner Grid: tag filter bar + list + compact-selected action bar -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Tag filter bar (P6-4) -->
                    <controls:TagFilterBar Grid.Row="0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                    <ItemsControl ItemsSource="{Binding InstancesView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WslInstanceViewModel}">
                                <ui:Card Margin="0,0,0,10" Padding="0">
                                    <Grid>
                                        <!-- Multi-select checkbox (visible only in select mode) -->
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Top"
                                                  HorizontalAlignment="Left"
                                                  Margin="8,8,0,0"
                                                  Panel.ZIndex="1"
                                                  Visibility="{Binding DataContext.IsMultiSelectMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Grid Margin="15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Instance Info -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                          FontSize="18"
                                                          FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Distribution}"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="{lex:Loc InstanceStateLabel}"
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding State}"
                                                              FontWeight="SemiBold"
                                                              Foreground="{Binding RawState, Converter={StaticResource InstanceStateToColorConverter}}"/>
                                                    <TextBlock Text="{lex:Loc InstanceDiskLabel}"
                                                              Margin="10,0,0,0"
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding DiskSizeDisplay}"
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text=" | "
                                                              Margin="10,0"
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding InstallPath}"
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <!-- Docker integration indicator (C-01-8) -->
                                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                                                Visibility="{Binding IsDockerStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DockerIntegrationEnabled}" Value="True">
                                                                            <Setter Property="Fill" Value="#22c55e"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="Docker" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- Tag chips row (P6-2) -->
                                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <ItemsControl ItemsSource="{Binding Tags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <controls:TagChipControl
                                                                    TagName="{Binding}"
                                                                    RemoveTagCommand="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- + Tag button -->
                                                    <Button Content="{lex:Loc Tag_AddTag}"
                                                            Command="{Binding AddTagCommand}"
                                                            Padding="6,1"
                                                            Margin="0,2,0,2"
                                                            FontSize="11"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="1"
                                                       Orientation="Horizontal"
                                                       VerticalAlignment="Center">
                                                <ui:Button Content="{lex:Loc InstanceStart}"
                                                          Icon="{ui:SymbolIcon Symbol=Play20}"
                                                          Command="{Binding StartCommand}"
                                                          Margin="0,0,5,0"
                                                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                <ui:Button Content="{lex:Loc InstanceStop}"
                                                          Icon="{ui:SymbolIcon Symbol=Stop20}"
                                                          Command="{Binding StopCommand}"
                                                          Margin="0,0,5,0"
                                                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ui:Button Content="{lex:Loc InstanceTerminal}"
                                                          Icon="{ui:SymbolIcon Symbol=WindowConsole20}"
                                                          Command="{Binding OpenTerminalCommand}"
                                                          Margin="0,0,5,0"/>
                                                <ui:DropDownButton Content="{lex:Loc InstanceMore}" Icon="{ui:SymbolIcon Symbol=MoreHorizontal20}">
                                                    <ui:DropDownButton.Flyout>
                                                        <ContextMenu>
                                                            <ui:MenuItem Header="{lex:Loc MoreMenu_Details}" Icon="{ui:SymbolIcon Symbol=Info20}" Command="{Binding OpenDetailsCommand}"/>
                                                            <Separator/>
                                                            <ui:MenuItem Header="{lex:Loc MoreMenu_CompactDisk}" Icon="{ui:SymbolIcon Symbol=DatabaseArrowDown20}" Command="{Binding CompactDiskCommand}"
                                                                         Visibility="{Binding IsWslV2, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <ui:MenuItem Header="{lex:Loc MoreMenu_ExportInstance}" Icon="{ui:SymbolIcon Symbol=ArrowExport20}" Command="{Binding ExportInstanceCommand}"/>
                                                            <Separator/>
                                                            <ui:MenuItem Header="{lex:Loc ActionMove}" Icon="{ui:SymbolIcon Symbol=ArrowMove20}" Command="{Binding MoveCommand}"/>
                                                            <ui:MenuItem Header="{lex:Loc ActionRename}" Icon="{ui:SymbolIcon Symbol=Rename20}" Command="{Binding RenameCommand}"/>
                                                            <ui:MenuItem Header="{lex:Loc ActionSetCredentials}" Icon="{ui:SymbolIcon Symbol=Key20}" Command="{Binding SetCredentialsCommand}"/>
                                                            <Separator/>
                                                            <ui:MenuItem Header="{lex:Loc ActionForceRefresh}" Icon="{ui:SymbolIcon Symbol=ArrowSync20}" Command="{Binding ForceRefreshCommand}"/>
                                                            <Separator/>
                                                            <ui:MenuItem Header="{lex:Loc ActionRemove}" Icon="{ui:SymbolIcon Symbol=Delete20}" Command="{Binding RemoveCommand}"/>
                                                        </ContextMenu>
                                                    </ui:DropDownButton.Flyout>
                                                </ui:DropDownButton>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Loading Overlay -->
                                        <Grid Background="#80000000"
                                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ui:ProgressRing IsIndeterminate="True"/>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                    <!-- Compact Selected action bar (multi-select mode) -->
                    <Border Grid.Row="2" Padding="0,8,0,0"
                            Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{lex:Loc Toolbar_CompactSelected}"
                                       Icon="{ui:SymbolIcon Symbol=DatabaseArrowDown20}"
                                       Command="{Binding CompactSelectedCommand}"
                                       Margin="0,0,12,0"/>
                            <ui:Button Content="{lex:Loc ButtonCancel}"
                                       Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                                       Command="{Binding CancelBulkCompactCommand}"
                                       Margin="0,0,12,0"
                                       Visibility="{Binding IsBulkCompacting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <!-- Bulk progress (shown while compacting) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsBulkCompacting, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding BulkCompactProgressText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding Instances.Count, Converter={StaticResource IntToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Apps48" FontSize="64" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{lex:Loc NoInstancesTitle}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,5"/>
                    <TextBlock Text="{lex:Loc NoInstancesSubtitle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Page Content Area -->
            <Frame Grid.Column="0" Grid.Row="1"
                   Content="{Binding CurrentPage}"
                   NavigationUIVisibility="Hidden"
                   Visibility="{Binding IsOnDashboard, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>

        </Grid>

        <!-- Loading Overlay (Global) -->
        <Grid Grid.Row="1"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="50" Height="50"/>
                <TextBlock Text="{lex:Loc LoadingText}"
                          Foreground="White"
                          FontSize="16"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Download Tasks Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsDownloadPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              MouseDown="DownloadOverlay_MouseDown">

            <!-- Download Panel (Floating Window) -->
            <Border Width="450"
                   MaxHeight="600"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,50,0"
                   Background="{DynamicResource ApplicationBackgroundBrush}"
                   BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                   BorderThickness="1"
                   CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="20" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{lex:Loc DownloadPanelTitle}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding ActiveDownloadsDisplayText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="14"/>
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                      Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                                      Command="{Binding ToggleDownloadPanelCommand}"
                                      ToolTip="{lex:Loc CloseTooltip}"/>
                        </Grid>
                    </Border>

                    <!-- Download List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <ItemsControl ItemsSource="{Binding DownloadJobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type package:PackageDownloadJob}">
                                    <ui:Card Margin="0,0,0,10" Padding="15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Package Info -->
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                      Text="{Binding PackageLabel}"
                                                      FontWeight="SemiBold"
                                                      TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                      Text="{Binding State}"
                                                      FontSize="12"
                                                      Margin="0,2,0,0"/>

                                            <!-- Progress (if downloading) -->
                                            <Grid Grid.Row="2" Grid.Column="0"
                                                  Margin="0,5,0,0"
                                                  Visibility="{Binding State, Converter={StaticResource DownloadingToVisibilityConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <ProgressBar Grid.Row="0"
                                                           Height="4"
                                                           Value="{Binding ProgressPercent}"
                                                           Maximum="100"
                                                           VerticalAlignment="Center"
                                                           Background="{DynamicResource ControlFillColorDefaultBrush}"/>

                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding OutcomeCode}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                                </Grid>
                                            </Grid>

                                            <!-- Actions -->
                                            <StackPanel Grid.Row="0" Grid.Column="1"
                                                       Grid.RowSpan="3"
                                                       Orientation="Horizontal"
                                                       VerticalAlignment="Top"
                                                       Margin="10,0,0,0">
                                                <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                                                          Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding JobId}"
                                                          ToolTip="{lex:Loc CancelTooltip}"
                                                          Margin="0,0,5,0"
                                                          Visibility="{Binding State, Converter={StaticResource DownloadStatusToActionVisibilityConverter}}"/>

                                                <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                                                          Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding JobId}"
                                                          ToolTip="{lex:Loc RetryTooltip}"
                                                          Visibility="{Binding State, Converter={StaticResource DownloadStatusToRetryVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                            <!-- Empty State -->
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DownloadJobs.Count}" Value="0">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50">
                                                            <ui:SymbolIcon Symbol="ArrowDownload48"
                                                                         FontSize="48"
                                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{lex:Loc NoDownloadTasksTitle}"
                                                                       FontSize="16"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,15,0,5"/>
                                                            <TextBlock Text="{lex:Loc NoDownloadTasksSubtitle}"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       FontSize="14"
                                                                       HorizontalAlignment="Center"
                                                                       TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2"
                           Padding="15"
                           Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                           BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                           BorderThickness="0,1,0,0">
                        <ui:Button Content="{lex:Loc ButtonClearCompleted}"
                                  Command="{Binding ClearCompletedDownloadsCommand}"
                                  HorizontalAlignment="Stretch"
                                  Appearance="Secondary"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <ui:InfoBar Grid.Row="2"
                    Title="{Binding StatusMessage}"
                    IsOpen="True"
                    Severity="Informational"
                    IsClosable="False"
                    Margin="0"/>
    </Grid>
</ui:FluentWindow>
