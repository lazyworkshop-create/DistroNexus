<Page x:Class="DistroNexus.Desktop.Views.ApplicationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lex="http://wpflocalizeextension.codeplex.com" xmlns:conv="clr-namespace:DistroNexus.Desktop.Converters" lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop" lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources">
  <Page.Resources><conv:ApplicationIconConverter x:Key="ApplicationIcon"/></Page.Resources>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8"><TextBox Width="180" Text="{Binding DistributionName,UpdateSourceTrigger=PropertyChanged}" ToolTip="{lex:Loc Applications_Distribution}" AutomationProperties.Name="{lex:Loc Applications_Distribution}"/><TextBox Width="180" Margin="8,0" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="{lex:Loc Applications_Search}" AutomationProperties.Name="{lex:Loc Applications_Search}"/><ui:Button Content="{lex:Loc Applications_Refresh}" Command="{Binding RefreshCommand}" AutomationProperties.Name="{lex:Loc Applications_Refresh}"/><ui:Button Content="{lex:Loc Applications_Launch}" Margin="8,0" Command="{Binding LaunchCommand}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{lex:Loc Applications_Launch}"/><ui:Button Content="{lex:Loc Applications_Pin}" Command="{Binding TogglePinCommand}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{lex:Loc Applications_Pin}"/><ui:Button Content="{lex:Loc Applications_Copy}" Margin="8,0" Command="{Binding CopyCommand}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{lex:Loc Applications_Copy}"/><ui:Button Content="{lex:Loc Applications_Reveal}" Margin="8,0" Command="{Binding RevealEntryCommand}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{lex:Loc Applications_Reveal}"/></StackPanel>
    <ListView Grid.Row="2" ItemsSource="{Binding FilteredApplications}" SelectedItem="{Binding SelectedApplication}" AutomationProperties.Name="{lex:Loc Applications_Title}"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Width="32" Height="32" Source="{Binding IconBytes,Converter={StaticResource ApplicationIcon}}"/><TextBlock Margin="8,0" Text="{Binding Name}"/><TextBlock Margin="8,0" Text="{Binding InstanceName}"/><TextBlock Margin="8,0" Text="{Binding CategoriesText}"/><TextBlock Margin="8,0" Text="{Binding Executable}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
  </Grid>
</Page>
