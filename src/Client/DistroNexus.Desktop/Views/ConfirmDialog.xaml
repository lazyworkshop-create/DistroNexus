<ui:FluentWindow x:Class="DistroNexus.Desktop.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Confirm"
        Width="450"
        Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon and Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <ui:SymbolIcon Symbol="Warning24" FontSize="32" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,15,0"/>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Message -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" 
                      Appearance="Secondary"
                      Margin="0,0,10,0"
                      Padding="20,8"
                      Click="CancelButton_Click"/>
            <ui:Button Content="{Binding ConfirmButtonText}" 
                      Appearance="Primary"
                      Padding="20,8"
                      Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
