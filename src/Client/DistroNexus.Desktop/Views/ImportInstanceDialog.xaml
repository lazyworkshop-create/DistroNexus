<ui:FluentWindow x:Class="DistroNexus.Desktop.Views.ImportInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
        lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
        Title="{lex:Loc Import_Title}"
        Width="480" Height="380"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0" Title="{lex:Loc Import_Title}"/>

        <!-- Form -->
        <StackPanel Grid.Row="1" Margin="20,12,20,12">
            <!-- Instance name -->
            <TextBlock Text="{lex:Loc Import_NameLabel}" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding NameError}" Foreground="Red" FontSize="11" Margin="0,0,0,8"
                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Install path -->
            <TextBlock Text="{lex:Loc Import_PathLabel}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                <ui:Button Grid.Column="1" Content="..." Command="{Binding BrowseInstallPathCommand}" Width="36"/>
            </Grid>
            <TextBlock Text="{Binding InstallPathError}" Foreground="Red" FontSize="11" Margin="0,0,0,8"
                       Visibility="{Binding HasInstallPathError, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Source TAR -->
            <TextBlock Text="{lex:Loc Import_SourceLabel}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                <ui:Button Grid.Column="1" Content="..." Command="{Binding BrowseSourceCommand}" Width="36"/>
            </Grid>
            <TextBlock Text="{Binding SourcePathError}" Foreground="Red" FontSize="11" Margin="0,0,0,8"
                       Visibility="{Binding HasSourcePathError, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{lex:Loc CancelTooltip}" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
                <ui:Button Content="{lex:Loc Import_Title}" Appearance="Primary"
                           Command="{Binding ConfirmCommand}"
                           IsEnabled="{Binding CanImport}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
