<ui:FluentWindow x:Class="DistroNexus.Desktop.Views.InstallWizardDialog"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
xmlns:properties="clr-namespace:DistroNexus.Desktop.Properties"
mc:Ignorable="d"
Title="{x:Static properties:Resources.InstallWizardTitle}" 
Height="550" 
Width="700"
WindowStartupLocation="CenterOwner"
WindowBackdropType="Mica"
ExtendsContentIntoTitleBar="True"
ResizeMode="NoResize"
d:DataContext="{d:DesignInstance Type=vm:InstallWizardViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" 
                     Title="{x:Static properties:Resources.InstallWizardTitle}"
                     ShowMaximize="False"
                     ShowMinimize="False"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Step Indicator -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="{x:Static properties:Resources.StepLabel}" FontSize="14"/>
                <TextBlock Text="{Binding CurrentStep}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{x:Static properties:Resources.OfLabel}" FontSize="14"/>
                <TextBlock Text="{Binding TotalSteps}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text=" - " FontSize="14"/>
                <TextBlock Text="{Binding StepTitle}" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Step Content -->
            <Grid Grid.Row="1">
                <!-- Step 1: Select Distribution -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.SelectDistroLabel}" FontSize="16" Margin="0,0,0,15"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding AvailableDistributions}"
                             SelectedItem="{Binding SelectedDistribution}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Apps24" Grid.Column="0" FontSize="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Step 2: Installation Path -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=2}">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Choose installation location:" FontSize="16" Margin="0,0,0,20"/>

                        <TextBlock Text="Instance Name:" Margin="0,0,0,5"/>
                        <ui:TextBox Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Enter instance name" Margin="0,0,0,15"/>

                        <TextBlock Text="Installation Path:" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                        Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="Select installation directory"/>
                            <ui:Button Grid.Column="1" 
                                       Content="{x:Static properties:Resources.Browse}" 
                                       Command="{Binding BrowseInstallPathCommand}" 
                                       Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{Binding PathValidationMessage}" 
                                   Margin="0,10,0,0"
                                   Foreground="{Binding IsPathValid, Converter={StaticResource BoolToValidationColorConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- Step 3: User Configuration -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=3}">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{x:Static properties:Resources.ConfigureUserAccount}" FontSize="16" Margin="0,0,0,20"/>

                        <ui:ToggleSwitch Content="{x:Static properties:Resources.CreateUserAccount}" 
                                         IsChecked="{Binding CreateUser}" 
                                         Margin="0,0,0,15"/>

                        <StackPanel IsEnabled="{Binding CreateUser}">
                            <TextBlock Text="{x:Static properties:Resources.LabelUsername}" Margin="0,0,0,5"/>
                            <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                        PlaceholderText="{x:Static properties:Resources.PlaceholderUsername}" 
                                        Margin="0,0,0,15"/>

                            <TextBlock Text="{x:Static properties:Resources.LabelPassword}" Margin="0,0,0,5"/>
                            <ui:PasswordBox Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                            PlaceholderText="{x:Static properties:Resources.PlaceholderPassword}" 
                                            Margin="0,0,0,15"/>

                            <TextBlock Text="{x:Static properties:Resources.LabelConfirmPassword}" Margin="0,0,0,5"/>
                            <ui:PasswordBox Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" 
                                            PlaceholderText="{x:Static properties:Resources.PlaceholderConfirmPassword}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Step 4: Review and Install -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=4}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.ReviewAndInstall}" FontSize="16" Margin="0,0,0,20"/>

                    <!-- Review Panel (visible when not installing) -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ui:Card Margin="0,0,0,15" Padding="15">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Text="{x:Static properties:Resources.InstallationSummary}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.LabelDistribution}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDistribution.Name}"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.InstanceNameLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstanceName}"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.LabelInstallPath}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallPath}" TextWrapping="Wrap"/>
                                    
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static properties:Resources.LabelUsername}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Username}"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:ToggleSwitch Content="{x:Static properties:Resources.OptionSetDefault}" IsChecked="{Binding SetAsDefault}" Margin="0,0,0,10"/>
                        <ui:ToggleSwitch Content="{x:Static properties:Resources.OptionLaunchAfter}" IsChecked="{Binding LaunchAfterInstall}"/>
                    </StackPanel>

                    <!-- Progress Panel (visible during installation) -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" 
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding InstallStatusMessage}" 
                                   HorizontalAlignment="Center" 
                                   FontSize="14" 
                                   Margin="0,15,0,0"/>
                        <ProgressBar Value="{Binding InstallProgress}" 
                                        Maximum="100" 
                                        Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Completion Panel -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" 
                                Visibility="{Binding InstallCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle48" FontSize="64" Foreground="Green" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Static properties:Resources.InstallSuccessLabel}" 
                                   HorizontalAlignment="Center" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Error Message -->
        <ui:InfoBar Grid.Row="1" 
                    Title="{x:Static properties:Resources.ErrorTitle}" 
                    Message="{Binding ErrorMessage}"
                    IsOpen="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                    Severity="Error"
                    VerticalAlignment="Bottom"
                    Margin="30,0,30,10"/>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="30,10,30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" 
                       Content="{x:Static properties:Resources.Cancel}" 
                       Command="{Binding CancelCommand}"
                       Visibility="{Binding InstallCompleted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>

            <ui:Button Grid.Column="1" 
                       Content="{x:Static properties:Resources.Back}" 
                       Command="{Binding GoBackCommand}"
                       IsEnabled="{Binding CanGoBack}"
                       Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                       Margin="0,0,10,0"/>

            <ui:Button Grid.Column="2" 
                       Content="{x:Static properties:Resources.Next}" 
                       Command="{Binding GoNextCommand}"
                       IsEnabled="{Binding CanGoNext}"
                       Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=NotFinal}"
                       Appearance="Primary"
                       Margin="0,0,10,0"/>

            <ui:Button Grid.Column="2" 
                       Content="{x:Static properties:Resources.Install}" 
                       Command="{Binding InstallCommand}"
                       Visibility="{Binding CurrentStep, Converter={StaticResource StepToVisibilityConverter}, ConverterParameter=Final}"
                       Appearance="Primary"
                       Margin="0,0,10,0"/>

            <ui:Button Grid.Column="3" 
                       Content="{x:Static properties:Resources.Finish}" 
                       Command="{Binding FinishCommand}"
                       Visibility="{Binding InstallCompleted, Converter={StaticResource BoolToVisibilityConverter}}"
                       Appearance="Primary"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
