<ui:FluentWindow x:Class="DistroNexus.Desktop.Views.InstallWizardDialogNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wizard="clr-namespace:DistroNexus.Desktop.Wizard"
        xmlns:properties="clr-namespace:DistroNexus.Desktop.Properties"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.InstallWizardTitle}" 
        Height="550" 
        Width="700"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type=wizard:InstallWizardWorkflowViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" 
                     Title="{x:Static properties:Resources.InstallWizardTitle}"
                     ShowMaximize="False"
                     ShowMinimize="False"/>

        <!-- Wizard Host -->
        <wizard:WizardHostControl Grid.Row="1" 
                                  DataContext="{Binding}"
                                  Margin="30,20"/>
    </Grid>
</ui:FluentWindow>
