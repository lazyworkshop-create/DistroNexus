<ui:FluentWindow x:Class="DistroNexus.Desktop.Views.InstanceDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
        lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
        xmlns:tabs="clr-namespace:DistroNexus.Desktop.Controls.Tabs"
        xmlns:controls="clr-namespace:DistroNexus.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InstanceDetailViewModel}"
        Title="{lex:Loc InstanceDetail_Title}"
        Width="780"
        Height="540"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Header strip -->
            <RowDefinition Height="*"/>
            <!-- Tab content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Instance.Name}"
                     ShowMaximize="False"
                     ShowMinimize="False"/>

        <!-- Header Strip: instance name, state badge -->
        <Border Grid.Row="1"
                Padding="20,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Desktop20" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Instance.Name}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Instance.Distribution}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Instance.State}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Instance.RawState, Converter={StaticResource InstanceStateToColorConverter}}"/>
                    </StackPanel>
                    <!-- Tag chips row (P6-3) -->
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Instance.Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TagChipControl
                                        TagName="{Binding}"
                                        RemoveTagCommand="{Binding DataContext.Instance.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{lex:Loc Tag_AddTag}"
                                Command="{Binding Instance.AddTagCommand}"
                                Padding="6,1"
                                Margin="0,2,0,2"
                                FontSize="11"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    BorderThickness="0"
                    Padding="0">
            <!-- Disk Tab -->
            <TabItem Header="{lex:Loc Tab_Disk}">
                <tabs:DiskTabView DataContext="{Binding DiskTab}"/>
            </TabItem>
            <!-- Resources Tab -->
            <TabItem Header="{lex:Loc Tab_Resources}">
                <tabs:ResourcesTabView DataContext="{Binding ResourcesTab}"/>
            </TabItem>
            <!-- Integrations Tab -->
            <TabItem Header="{lex:Loc Tab_Integrations}"
                     Visibility="{Binding IntegrationsTab.IsTabVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <tabs:IntegrationsTabView DataContext="{Binding IntegrationsTab}"/>
            </TabItem>
            <!-- Network Tab -->
            <TabItem Header="{lex:Loc Tab_Network}">
                <tabs:NetworkTabView DataContext="{Binding NetworkTab}"/>
            </TabItem>
            <!-- Backup Tab -->
            <TabItem Header="{lex:Loc Tab_Backup}">
                <tabs:BackupTabView DataContext="{Binding BackupTab}"/>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3"
                Padding="20,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{lex:Loc InstanceDetail_Close}"
                           Appearance="Primary"
                           Padding="20,8"
                           Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
