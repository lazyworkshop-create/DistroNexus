<Page x:Class="DistroNexus.Desktop.Views.PackageManagerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
  mc:Ignorable="d"
  Title="{lex:Loc PackageManagerTitle}"
  Loaded="Page_Loaded"
  d:DataContext="{d:DesignInstance Type=vm:PackageManagerViewModel}">
    
<Grid Margin="0">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
            <ui:Button Content="{lex:Loc Refresh}" 
                      Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                      Command="{Binding RefreshCatalogCommand}"
                      Margin="0,0,10,0"/>
            <ui:Button Content="{lex:Loc Update}" 
                      Icon="{ui:SymbolIcon Symbol=CloudSync20}"
                      Command="{Binding UpdateSourcesCommand}"
                      ToolTip="{lex:Loc UpdateCatalogTooltip}"
                      Margin="0,0,10,0"/>
            <ui:Button Content="{lex:Loc Download}" 
                      Icon="{ui:SymbolIcon Symbol=ArrowDownload20}"
                      Command="{Binding DownloadAllCommand}"
                      ToolTip="{lex:Loc DownloadAllTooltip}"
                      Margin="0,0,10,0"/>
            <ui:TextBox PlaceholderText="{lex:Loc SearchPlaceholder}" 
                       Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                       Height="36"
                       MinWidth="250"
                       Margin="0,0,10,0"/>
            <ui:Button Content="{lex:Loc AddSource}" 
                      Icon="{ui:SymbolIcon Symbol=Add20}"
                      Command="{Binding ToggleAddSourcePanelCommand}"
                      Margin="0,0,10,0"/>
            
            <!-- Offline Mode Indicator -->
            <ui:InfoBadge Severity="Caution"
                         Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVisibilityConverter}}"
                         VerticalAlignment="Center"
                         Margin="0,0,5,0"/>
            <TextBlock Text="{lex:Loc OfflineMode}" 
                      Foreground="Orange"
                      FontWeight="SemiBold"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <ui:Button Grid.Column="1" 
                  Content="{lex:Loc Back}" 
                  Icon="{ui:SymbolIcon Symbol=ArrowLeft20}"
                  Command="{Binding GoBackCommand}"/>
    </Grid>

        <!-- Package List Grouped by Category -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <ItemsControl ItemsSource="{Binding GroupedPackages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PackageGroup}">
                        <StackPanel Margin="0,0,0,20">
                            <!-- Category Header -->
                            <TextBlock Text="{Binding Category}" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,10"/>
                            
                            <!-- Packages in Category -->
                            <ItemsControl ItemsSource="{Binding Packages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Margin="0,0,0,8" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <ui:SymbolIcon Grid.Column="0" 
                                                              Symbol="Box20" 
                                                              FontSize="36"
                                                              Margin="0,0,12,0"/>

                                                <!-- Package Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" 
                                                                  FontSize="15" 
                                                                  FontWeight="SemiBold"/>
                                                        <ui:Badge Content="{lex:Loc BadgeCached}" 
                                                                 Appearance="Success" 
                                                                 Margin="8,0,0,0"
                                                                 Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <ui:Badge Content="{lex:Loc BadgeOnline}" 
                                                                 Appearance="Info" 
                                                                 Margin="8,0,0,0"
                                                                 Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                        <ui:Badge Content="{lex:Loc BadgeCustom}" 
                                                                 Appearance="Caution" 
                                                                 Margin="8,0,0,0"
                                                                 Visibility="{Binding IsCustomSource, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" 
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                              TextTrimming="CharacterEllipsis"
                                                              TextWrapping="NoWrap"
                                                              HorizontalAlignment="Left"
                                                              Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Version}" 
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                  FontSize="12"/>
                                                        <TextBlock Text=" | " 
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                  FontSize="12"/>
                                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeFormatter}}" 
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                  FontSize="12"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Download/Cancel/Install Actions -->
                                                <!-- Download Button (visible when not cached and not downloading) -->
                                                <ui:Button Grid.Column="2" 
                                                          Content="{lex:Loc ActionDownload}" 
                                                          Icon="{ui:SymbolIcon Symbol=ArrowDownload20}"
                                                          Command="{Binding DataContext.DownloadPackageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          CommandParameter="{Binding}"
                                                          Appearance="Primary"
                                                          Margin="0,0,5,0">
                                                    <ui:Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiConditionVisibilityConverter}">
                                                            <Binding Path="IsCached"/>
                                                            <Binding Path="IsDownloading"/>
                                                        </MultiBinding>
                                                    </ui:Button.Visibility>
                                                </ui:Button>
                                                
                                                <!-- Cancel Button (visible when downloading) -->
                                                <ui:Button Grid.Column="2" 
                                                          Content="{lex:Loc ButtonCancel}" 
                                                          Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                                                          Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          CommandParameter="{Binding}"
                                                          Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          Appearance="Caution"
                                                          Margin="0,0,5,0"/>
                                                
                                                <!-- Install Button (for cached packages, not downloading) -->
                                                <ui:Button Grid.Column="3" 
                                                          Content="{lex:Loc ActionInstall}" 
                                                          Icon="{ui:SymbolIcon Symbol=Add20}"
                                                          Command="{Binding DataContext.InstallCachedPackageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          CommandParameter="{Binding}"
                                                          Appearance="Success"
                                                          Margin="0,0,5,0">
                                                    <ui:Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource CachedNotDownloadingVisibilityConverter}">
                                                            <Binding Path="IsCached"/>
                                                            <Binding Path="IsDownloading"/>
                                                        </MultiBinding>
                                                    </ui:Button.Visibility>
                                                </ui:Button>
                                                
                                                <!-- More Actions DropDown (for cached packages, not downloading) -->
                                                <ui:DropDownButton Grid.Column="4" 
                                                                   Content="{lex:Loc InstanceMore}" 
                                                                   Icon="{ui:SymbolIcon Symbol=MoreHorizontal20}"
                                                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                                                    <ui:DropDownButton.Visibility>
                                                        <MultiBinding Converter="{StaticResource CachedNotDownloadingVisibilityConverter}">
                                                            <Binding Path="IsCached"/>
                                                            <Binding Path="IsDownloading"/>
                                                        </MultiBinding>
                                                    </ui:DropDownButton.Visibility>
                                                    <ui:DropDownButton.Flyout>
                                                        <ContextMenu>
                                                            <ui:MenuItem Header="{lex:Loc ActionRedownload}" 
                                                                        Icon="{ui:SymbolIcon Symbol=ArrowSync20}" 
                                                                        Command="{Binding PlacementTarget.Tag.RedownloadPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <Separator/>
                                                            <ui:MenuItem Header="{lex:Loc ActionDeleteCache}" 
                                                                        Icon="{ui:SymbolIcon Symbol=Delete20}" 
                                                                        Command="{Binding PlacementTarget.Tag.DeletePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        </ContextMenu>
                                                    </ui:DropDownButton.Flyout>
                                                </ui:DropDownButton>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add Source Panel Overlay (prevents interaction with other elements) -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsAddSourcePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              MouseDown="Overlay_MouseDown"/>

        <!-- Custom Source Panel (toggleable) -->
        <ui:Card Grid.Row="2" Padding="12" Margin="0,15,0,0"
                 Visibility="{Binding IsAddSourcePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="{lex:Loc CustomSourceUrlLabel}" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ui:TextBox Grid.Column="1" 
                           Text="{Binding CustomSourceUrl, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="https://example.com/catalog.json"/>
                <ui:Button Grid.Column="2" 
                          Content="{lex:Loc ActionAdd}" 
                          Icon="{ui:SymbolIcon Symbol=Add20}"
                          Command="{Binding AddCustomSourceCommand}"
                          Appearance="Primary"
                          Margin="10,0,0,0"/>
                <ui:Button Grid.Column="3" 
                          Content="{lex:Loc ButtonCancel}" 
                          Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                          Command="{Binding ToggleAddSourcePanelCommand}"
                          Margin="5,0,0,0"/>
            </Grid>
        </ui:Card>

        <!-- Loading Overlay -->
        <Grid Grid.Row="1" 
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="50" Height="50"/>
                <TextBlock Text="{lex:Loc LoadingCatalog}" 
                          Foreground="White" 
                          FontSize="16" 
                          Margin="0,10,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
