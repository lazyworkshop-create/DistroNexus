<Page x:Class="DistroNexus.Desktop.Views.PackageManagerPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
  mc:Ignorable="d"
  Title="Package Manager"
  Loaded="Page_Loaded"
  d:DataContext="{d:DesignInstance Type=vm:PackageManagerViewModel}">
    
<Grid Margin="0">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
            <ui:Button Content="Refresh" 
                      Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                      Command="{Binding RefreshCatalogCommand}"
                      Margin="0,0,10,0"/>
            <ui:TextBox PlaceholderText="Search distributions..." 
                       Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                       Width="300"
                       Margin="0,0,10,0"/>
            <ui:Button Content="Add Source" 
                      Icon="{ui:SymbolIcon Symbol=Add20}"
                      Command="{Binding ToggleAddSourcePanelCommand}"
                      Margin="0,0,10,0"/>
            
            <!-- Offline Mode Indicator -->
            <ui:InfoBadge Severity="Caution"
                         Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVisibilityConverter}}"
                         VerticalAlignment="Center"
                         Margin="0,0,5,0"/>
            <TextBlock Text="Offline Mode" 
                      Foreground="Orange"
                      FontWeight="SemiBold"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <TextBlock Grid.Column="1" 
                   Text="{Binding StatusMessage}" 
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,15,0"/>
        
        <ui:Button Grid.Column="2" 
                  Content="Back" 
                  Icon="{ui:SymbolIcon Symbol=ArrowLeft20}"
                  Command="{Binding GoBackCommand}"/>
    </Grid>

        <!-- Package List Grouped by Category -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GroupedPackages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PackageGroup}">
                        <StackPanel Margin="0,0,0,20">
                            <!-- Category Header -->
                            <TextBlock Text="{Binding Category}" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,10"/>
                            
                            <!-- Packages in Category -->
                            <ItemsControl ItemsSource="{Binding Packages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Margin="0,0,0,8" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <ui:SymbolIcon Grid.Column="0" 
                                                              Symbol="Box20" 
                                                              FontSize="36"
                                                              Margin="0,0,12,0"/>

                                                <!-- Package Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" 
                                                                  FontSize="15" 
                                                                  FontWeight="SemiBold"/>
                                                        <ui:Badge Content="Cached" 
                                                                 Appearance="Success" 
                                                                 Margin="8,0,0,0"
                                                                 Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <ui:Badge Content="Online" 
                                                                 Appearance="Info" 
                                                                 Margin="8,0,0,0"
                                                                 Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                        <ui:Badge Content="Custom" 
                                                                 Appearance="Caution" 
                                                                 Margin="8,0,0,0"
                                                                 Visibility="{Binding IsCustomSource, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" 
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                              TextTrimming="CharacterEllipsis"
                                                              MaxWidth="400"
                                                              Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Version}" 
                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                  FontSize="11"/>
                                                        <TextBlock Text=" | " Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeFormatter}}" 
                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                  FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Download/Delete Actions -->
                                                <ui:Button Grid.Column="2" 
                                                          Content="Download" 
                                                          Icon="{ui:SymbolIcon Symbol=ArrowDownload20}"
                                                          Command="{Binding DataContext.DownloadPackageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          CommandParameter="{Binding}"
                                                          Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                                          Appearance="Primary"
                                                          Margin="0,0,5,0"/>
                                                
                                                <!-- More Actions DropDown (for cached packages) -->
                                                <ui:DropDownButton Grid.Column="3" 
                                                                   Content="Actions" 
                                                                   Icon="{ui:SymbolIcon Symbol=MoreHorizontal20}"
                                                                   Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ui:DropDownButton.Flyout>
                                                        <ContextMenu>
                                                            <ui:MenuItem Header="Redownload" 
                                                                        Icon="{ui:SymbolIcon Symbol=ArrowSync20}" 
                                                                        Command="{Binding DataContext.RedownloadPackageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                        CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <ui:MenuItem Header="Delete Cache" 
                                                                        Icon="{ui:SymbolIcon Symbol=Delete20}" 
                                                                        Command="{Binding DataContext.DeletePackageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                        CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </ui:DropDownButton.Flyout>
                                                </ui:DropDownButton>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add Source Panel Overlay (prevents interaction with other elements) -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsAddSourcePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              MouseDown="Overlay_MouseDown"/>

        <!-- Custom Source Panel (toggleable) -->
        <ui:Card Grid.Row="2" Padding="12" Margin="0,15,0,0"
                 Visibility="{Binding IsAddSourcePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="Custom Source URL:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ui:TextBox Grid.Column="1" 
                           Text="{Binding CustomSourceUrl, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="https://example.com/distros.json"/>
                <ui:Button Grid.Column="2" 
                          Content="Add" 
                          Icon="{ui:SymbolIcon Symbol=Add20}"
                          Command="{Binding AddCustomSourceCommand}"
                          Appearance="Primary"
                          Margin="10,0,0,0"/>
                <ui:Button Grid.Column="3" 
                          Content="Cancel" 
                          Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                          Command="{Binding ToggleAddSourcePanelCommand}"
                          Margin="5,0,0,0"/>
            </Grid>
        </ui:Card>

        <!-- Loading Overlay -->
        <Grid Grid.Row="1" 
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="50" Height="50"/>
                <TextBlock Text="Loading catalog..." 
                          Foreground="White" 
                          FontSize="16" 
                          Margin="0,10,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
