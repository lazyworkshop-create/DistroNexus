<Page x:Class="DistroNexus.Desktop.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
      xmlns:ctrl="clr-namespace:DistroNexus.Desktop.Controls"
      mc:Ignorable="d"
      Title="{lex:Loc SettingsTitle}"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Dirty Indicator -->
                <TextBlock Text="* You have unsaved changes" 
                           Foreground="Orange"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                
                <ui:Button Content="{lex:Loc ResetToDefaults}" 
                           Icon="{ui:SymbolIcon Symbol=ArrowReset20}"
                           Command="{Binding ResetSettingsCommand}"
                           Margin="0,0,10,0"/>
                
                <ui:Button Content="{lex:Loc SaveSettings}" 
                           Icon="{ui:SymbolIcon Symbol=Save20}"
                           Command="{Binding SaveSettingsCommand}"
                           Appearance="Primary"/>
            </StackPanel>
            
            <ui:Button Grid.Column="1" 
                      Content="{lex:Loc Back}" 
                      Icon="{ui:SymbolIcon Symbol=ArrowLeft20}"
                      Command="{Binding GoBackCommand}"/>
        </Grid>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0">
                <!-- General Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc GeneralSettings}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="{lex:Loc DefaultInstallPath}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                       Text="{Binding DefaultInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                       Margin="0,0,10,0"/>
                            <ui:Button Grid.Column="1" 
                                      Content="{lex:Loc Browse}"
                                      Icon="{ui:SymbolIcon Symbol=Folder20}"
                                      Command="{Binding BrowseInstallPathCommand}"/>
                        </Grid>

                        <TextBlock Text="{lex:Loc PackageCachePath}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                       Text="{Binding PackageCachePath, UpdateSourceTrigger=PropertyChanged}"
                                       Margin="0,0,10,0"/>
                            <ui:Button Grid.Column="1" 
                                      Content="{lex:Loc Browse}"
                                      Icon="{ui:SymbolIcon Symbol=Folder20}"
                                      Command="{Binding BrowseCachePathCommand}"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{lex:Loc DefaultWslVersion}" Margin="0,0,0,5"/>
                                <ComboBox SelectedIndex="{Binding WslVersionIndex}">
                                    <ComboBoxItem Content="{lex:Loc WslVersion1}"/>
                                    <ComboBoxItem Content="{lex:Loc WslVersion2Recommended}"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{lex:Loc DefaultUsername}" Margin="0,0,0,5"/>
                                <ui:TextBox Text="{Binding DefaultUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{lex:Loc DefaultTerminalStartPath}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                       Text="{Binding TerminalStartPath, UpdateSourceTrigger=PropertyChanged}"
                                       PlaceholderText="{lex:Loc TerminalPathPlaceholder}"
                                       Margin="0,0,10,0"/>
                            <ui:Button Grid.Column="1" 
                                      Content="{lex:Loc Browse}"
                                      Icon="{ui:SymbolIcon Symbol=Folder20}"
                                      Command="{Binding BrowseTerminalPathCommand}"/>
                        </Grid>

                        <TextBlock Text="{lex:Loc DefaultDistro}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding AvailableDistributions}" 
                                  SelectedItem="{Binding DefaultDistribution}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Appearance Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Appearance}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="{lex:Loc Theme}" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Margin="0,0,0,15">
                            <ComboBoxItem Tag="Light" Content="{lex:Loc ThemeLight}"/>
                            <ComboBoxItem Tag="Dark" Content="{lex:Loc ThemeDark}"/>
                            <ComboBoxItem Tag="Auto" Content="{lex:Loc ThemeAuto}"/>
                        </ComboBox>

                        <TextBlock Text="{lex:Loc Language}" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding Language}" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="en-US" Content="{lex:Loc LangEnglish}"/>
                            <ComboBoxItem Tag="zh-CN" Content="{lex:Loc LangChinese}"/>
                        </ComboBox>
                    </StackPanel>
                </ui:Card>

                <!-- Download Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc DownloadSettings}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="{lex:Loc OnlineCatalogUrl}" Margin="0,0,0,5"/>
                        <ui:TextBox Text="{Binding CatalogUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{lex:Loc MaxConcurrentDownloads}" Margin="0,0,0,5"/>
                                <ui:NumberBox Value="{Binding MaxConcurrentDownloads}" 
                                              Minimum="1" 
                                              Maximum="10"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{lex:Loc MaxRetryAttempts}" Margin="0,0,0,5"/>
                                <ui:NumberBox Value="{Binding MaxRetryAttempts}" 
                                              Minimum="0" 
                                              Maximum="10"/>
                            </StackPanel>
                        </Grid>

                        <ui:ToggleSwitch Content="{lex:Loc AutoRetryFailedDownloads}" 
                                         IsChecked="{Binding AutoRetryDownloads}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Cache Management -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc CacheManagement}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{lex:Loc PackageCacheLocation}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CachePath}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <ui:Button Grid.Column="1" 
                                      Content="{lex:Loc OpenFolder}"
                                      Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                                      Command="{Binding OpenCacheFolderCommand}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{lex:Loc CachedPackages}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CachedPackageCount}" 
                                           FontSize="24" 
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{lex:Loc TotalSize}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CacheTotalSize}" 
                                           FontSize="24" 
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{lex:Loc Refresh}" 
                                      Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                                      Command="{Binding RefreshCacheInfoCommand}"
                                      Margin="0,0,10,0"/>
                            <ui:Button Content="{lex:Loc ClearAllCache}" 
                                      Icon="{ui:SymbolIcon Symbol=Delete20}"
                                      Command="{Binding ClearCacheCommand}"
                                      Appearance="Danger"/>
                        </StackPanel>

                        <!-- Cached Packages List -->
                        <TextBlock Text="{lex:Loc CachedFiles}" 
                                   Margin="0,20,0,10"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding CachedPackageCount, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        <ItemsControl ItemsSource="{Binding CachedPackages}" 
                                      MaxHeight="200"
                                      Visibility="{Binding CachedPackageCount, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}" 
                                                          FontWeight="SemiBold"
                                                          TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                          FontSize="11">
                                                    <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                                    <Run Text="{lex:Loc CachedDateLabel}"/>
                                                    <Run Text="{Binding CachedDate, StringFormat='{}{0:yyyy-MM-dd}', Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="1" 
                                                      Text="{Binding SizeDisplay}" 
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Margin="0,0,15,0"/>
                                            
                                            <ui:Button Grid.Column="2" 
                                                      ToolTip="{lex:Loc DeleteCachedFileTooltip}"
                                                      Icon="{ui:SymbolIcon Symbol=Delete16}"
                                                      Command="{Binding DataContext.DeleteCachedPackageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding}"
                                                      Appearance="Secondary"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Advanced Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc AdvancedSettings}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    </StackPanel>
                </ui:Card>

                <!-- Behavior Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Behavior}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <ui:ToggleSwitch Content="{lex:Loc EnableLogging}" 
                                         IsChecked="{Binding EnableLogging}"
                                         Margin="0,0,0,10"/>
                        
                        <ui:ToggleSwitch Content="{lex:Loc CheckUpdatesOnStartup}" 
                                         IsChecked="{Binding CheckUpdatesOnStartup}"
                                         IsEnabled="{Binding IsUpdateCheckOnStartupAvailable}"
                                         Margin="0,0,0,10"/>
                        
                        <ui:ToggleSwitch Content="{lex:Loc ShowConfirmationDialogs}" 
                                         IsChecked="{Binding ShowConfirmationDialogs}"
                                         Margin="0,0,0,10"/>
                        
                        <ui:ToggleSwitch Content="{lex:Loc EnableAutoSave}" 
                                         IsChecked="{Binding AutoSaveEnabled}"
                                         Margin="0,0,0,10"/>
                        
                        <Grid Visibility="{Binding AutoSaveEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="{lex:Loc AutoSaveInterval}" Margin="0,0,0,5"/>
                            <ui:NumberBox Grid.Row="1" Value="{Binding AutoSaveInterval}" 
                                          Minimum="30" 
                                          Maximum="300"
                                          Margin="0,0,0,15"/>
                        </Grid>
                        
                    </StackPanel>
                </ui:Card>

                <!-- Manage Tags section (E-02-9) -->
                <ctrl:ManageTagsSectionView DataContext="{Binding ManageTags}" Margin="0,0,0,15"/>

                <!-- WSL Global Configuration section (E-01) -->
                <ctrl:WslConfigSectionView DataContext="{Binding WslConfigSection}" Margin="0,0,0,15"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
