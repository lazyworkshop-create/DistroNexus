<Page x:Class="DistroNexus.Desktop.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
      xmlns:properties="clr-namespace:DistroNexus.Desktop.Properties"
      mc:Ignorable="d"
      Title="{x:Static properties:Resources.SettingsTitle}"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Dirty Indicator -->
                <TextBlock Text="* You have unsaved changes" 
                           Foreground="Orange"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                
                <ui:Button Content="{x:Static properties:Resources.ResetToDefaults}" 
                           Icon="{ui:SymbolIcon Symbol=ArrowReset20}"
                           Command="{Binding ResetSettingsCommand}"
                           Margin="0,0,10,0"/>
                
                <ui:Button Content="{x:Static properties:Resources.SaveSettings}" 
                           Icon="{ui:SymbolIcon Symbol=Save20}"
                           Command="{Binding SaveSettingsCommand}"
                           Appearance="Primary"/>
            </StackPanel>
            
            <ui:Button Grid.Column="1" 
                      Content="{x:Static properties:Resources.Back}" 
                      Icon="{ui:SymbolIcon Symbol=ArrowLeft20}"
                      Command="{Binding GoBackCommand}"/>
        </Grid>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0">
                <!-- General Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.GeneralSettings}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="{x:Static properties:Resources.DefaultInstallPath}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                       Text="{Binding DefaultInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                       Margin="0,0,10,0"/>
                            <ui:Button Grid.Column="1" 
                                      Content="{x:Static properties:Resources.Browse}"
                                      Icon="{ui:SymbolIcon Symbol=Folder20}"
                                      Command="{Binding BrowseInstallPathCommand}"/>
                        </Grid>

                        <TextBlock Text="{x:Static properties:Resources.PackageCachePath}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                       Text="{Binding PackageCachePath, UpdateSourceTrigger=PropertyChanged}"
                                       Margin="0,0,10,0"/>
                            <ui:Button Grid.Column="1" 
                                      Content="{x:Static properties:Resources.Browse}"
                                      Icon="{ui:SymbolIcon Symbol=Folder20}"
                                      Command="{Binding BrowseCachePathCommand}"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{x:Static properties:Resources.DefaultWslVersion}" Margin="0,0,0,5"/>
                                <ComboBox SelectedIndex="{Binding WslVersionIndex}">
                                    <ComboBoxItem Content="{x:Static properties:Resources.WslVersion1}"/>
                                    <ComboBoxItem Content="{x:Static properties:Resources.WslVersion2Recommended}"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static properties:Resources.DefaultUsername}" Margin="0,0,0,5"/>
                                <ui:TextBox Text="{Binding DefaultUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Static properties:Resources.DefaultTerminalStartPath}" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                       Text="{Binding TerminalStartPath, UpdateSourceTrigger=PropertyChanged}"
                                       PlaceholderText="{x:Static properties:Resources.TerminalPathPlaceholder}"
                                       Margin="0,0,10,0"/>
                            <ui:Button Grid.Column="1" 
                                      Content="{x:Static properties:Resources.Browse}"
                                      Icon="{ui:SymbolIcon Symbol=Folder20}"
                                      Command="{Binding BrowseTerminalPathCommand}"/>
                        </Grid>

                        <TextBlock Text="{x:Static properties:Resources.DefaultDistro}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding AvailableDistributions}" 
                                  SelectedItem="{Binding DefaultDistribution}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Appearance Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.Appearance}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="{x:Static properties:Resources.Theme}" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Margin="0,0,0,15">
                            <ComboBoxItem Tag="Light" Content="{x:Static properties:Resources.ThemeLight}"/>
                            <ComboBoxItem Tag="Dark" Content="{x:Static properties:Resources.ThemeDark}"/>
                            <ComboBoxItem Tag="Auto" Content="{x:Static properties:Resources.ThemeAuto}"/>
                        </ComboBox>

                        <TextBlock Text="{x:Static properties:Resources.Language}" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding Language}" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="en-US" Content="{x:Static properties:Resources.LangEnglish}"/>
                            <ComboBoxItem Tag="zh-CN" Content="{x:Static properties:Resources.LangChinese}"/>
                        </ComboBox>
                    </StackPanel>
                </ui:Card>

                <!-- Download Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.DownloadSettings}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="{x:Static properties:Resources.OnlineCatalogUrl}" Margin="0,0,0,5"/>
                        <ui:TextBox Text="{Binding CatalogUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{x:Static properties:Resources.MaxConcurrentDownloads}" Margin="0,0,0,5"/>
                                <ui:NumberBox Value="{Binding MaxConcurrentDownloads}" 
                                              Minimum="1" 
                                              Maximum="10"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static properties:Resources.MaxRetryAttempts}" Margin="0,0,0,5"/>
                                <ui:NumberBox Value="{Binding MaxRetryAttempts}" 
                                              Minimum="0" 
                                              Maximum="10"/>
                            </StackPanel>
                        </Grid>

                        <ui:ToggleSwitch Content="{x:Static properties:Resources.AutoRetryFailedDownloads}" 
                                         IsChecked="{Binding AutoRetryDownloads}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Cache Management -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.CacheManagement}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static properties:Resources.PackageCacheLocation}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CachePath}" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <ui:Button Grid.Column="1" 
                                      Content="{x:Static properties:Resources.OpenFolder}"
                                      Icon="{ui:SymbolIcon Symbol=FolderOpen20}"
                                      Command="{Binding OpenCacheFolderCommand}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{x:Static properties:Resources.CachedPackages}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CachedPackageCount}" 
                                           FontSize="24" 
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static properties:Resources.TotalSize}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CacheTotalSize}" 
                                           FontSize="24" 
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{x:Static properties:Resources.Refresh}" 
                                      Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                                      Command="{Binding RefreshCacheInfoCommand}"
                                      Margin="0,0,10,0"/>
                            <ui:Button Content="{x:Static properties:Resources.ClearAllCache}" 
                                      Icon="{ui:SymbolIcon Symbol=Delete20}"
                                      Command="{Binding ClearCacheCommand}"
                                      Appearance="Danger"/>
                        </StackPanel>

                        <!-- Cached Packages List -->
                        <TextBlock Text="{x:Static properties:Resources.CachedFiles}" 
                                   Margin="0,20,0,10"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding CachedPackageCount, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        <ItemsControl ItemsSource="{Binding CachedPackages}" 
                                      MaxHeight="200"
                                      Visibility="{Binding CachedPackageCount, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}" 
                                                          FontWeight="SemiBold"
                                                          TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                          FontSize="11">
                                                    <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                                    <Run Text="{x:Static properties:Resources.CachedDateLabel}"/>
                                                    <Run Text="{Binding CachedDate, StringFormat='{}{0:yyyy-MM-dd}', Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="1" 
                                                      Text="{Binding SizeDisplay}" 
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Margin="0,0,15,0"/>
                                            
                                            <ui:Button Grid.Column="2" 
                                                      ToolTip="{x:Static properties:Resources.DeleteCachedFileTooltip}"
                                                      Icon="{ui:SymbolIcon Symbol=Delete16}"
                                                      Command="{Binding DataContext.DeleteCachedPackageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding}"
                                                      Appearance="Secondary"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Advanced Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.AdvancedSettings}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock Text="{x:Static properties:Resources.PowerShellModulePathHeader}" Margin="0,0,0,5"/>
                        <TextBlock Text="{x:Static properties:Resources.PowerShellModulePathDescription}" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                       Text="{Binding PowerShellModulePath, UpdateSourceTrigger=PropertyChanged}"
                                       PlaceholderText="{x:Static properties:Resources.PowerShellModulePathPlaceholder}"
                                       Margin="0,0,10,0"/>
                            <ui:Button Grid.Column="1" 
                                      Content="{x:Static properties:Resources.Browse}"
                                      Icon="{ui:SymbolIcon Symbol=Folder20}"
                                      Command="{Binding BrowsePowerShellModulePathCommand}"
                                      Margin="0,0,10,0"/>
                            <ui:Button Grid.Column="2" 
                                      Content="{x:Static properties:Resources.Clear}"
                                      Icon="{ui:SymbolIcon Symbol=Delete20}"
                                      Command="{Binding ClearPowerShellModulePathCommand}"
                                      Appearance="Secondary"/>
                        </Grid>

                        <ui:InfoBar Title="{x:Static properties:Resources.ModulePathConfigTitle}" 
                                    Severity="Informational"
                                    IsOpen="True"
                                    IsClosable="False">
                            <ui:InfoBar.Content>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{x:Static properties:Resources.ModulePathInfo1}"/>
                                    <LineBreak/>
                                    <Run Text="{x:Static properties:Resources.ModulePathInfo2}"/>
                                    <LineBreak/>
                                    <Run Text="{x:Static properties:Resources.ModulePathSearchLoc1}"/>
                                    <LineBreak/>
                                    <Run Text="{x:Static properties:Resources.ModulePathSearchLoc2}"/>
                                    <LineBreak/>
                                    <Run Text="{x:Static properties:Resources.ModulePathSearchLoc3}"/>
                                    <LineBreak/>
                                    <Run Text="{x:Static properties:Resources.ModulePathSearchLoc4}"/>
                                </TextBlock>
                            </ui:InfoBar.Content>
                        </ui:InfoBar>
                    </StackPanel>
                </ui:Card>

                <!-- Behavior Settings -->
                <ui:Card Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.Behavior}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <ui:ToggleSwitch Content="{x:Static properties:Resources.EnableLogging}" 
                                         IsChecked="{Binding EnableLogging}"
                                         Margin="0,0,0,10"/>
                        
                        <ui:ToggleSwitch Content="{x:Static properties:Resources.CheckUpdatesOnStartup}" 
                                         IsChecked="{Binding CheckUpdatesOnStartup}"
                                         Margin="0,0,0,10"/>
                        
                        <ui:ToggleSwitch Content="{x:Static properties:Resources.ShowConfirmationDialogs}" 
                                         IsChecked="{Binding ShowConfirmationDialogs}"
                                         Margin="0,0,0,10"/>
                        
                        <ui:ToggleSwitch Content="{x:Static properties:Resources.EnableAutoSave}" 
                                         IsChecked="{Binding AutoSaveEnabled}"
                                         Margin="0,0,0,10"/>
                        
                        <Grid Visibility="{Binding AutoSaveEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="{x:Static properties:Resources.AutoSaveInterval}" Margin="0,0,0,5"/>
                            <ui:NumberBox Grid.Row="1" Value="{Binding AutoSaveInterval}" 
                                          Minimum="30" 
                                          Maximum="300"
                                          Margin="0,0,0,15"/>
                        </Grid>
                        
                        <TextBlock Text="{x:Static properties:Resources.LogFilePath}" Margin="0,15,0,5" 
                                   Visibility="{Binding EnableLogging, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:TextBox Text="{Binding LogPath}" 
                                   IsReadOnly="True"
                                   Visibility="{Binding EnableLogging, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
