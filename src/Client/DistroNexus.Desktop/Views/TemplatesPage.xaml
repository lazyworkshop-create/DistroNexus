<Page x:Class="DistroNexus.Desktop.Views.TemplatesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:lex="http://wpflocalizeextension.codeplex.com"
  lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
  lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DistroNexus.Desktop.ViewModels"
  mc:Ignorable="d" 
  Title="Templates"
  d:DataContext="{d:DesignInstance Type=vm:TemplatesViewModel}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{lex:Loc Refresh}" 
                          Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                          Command="{Binding LoadTemplatesCommand}"
                          Margin="0,0,10,0"/>
                <ui:Button Content="{lex:Loc ActionImport}" 
                          Icon="{ui:SymbolIcon Symbol=ArrowImport20}"
                          Command="{Binding ImportTemplateCommand}"
                          Visibility="Collapsed"
                          Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory}"
                          Width="120"
                          Height="36"
                          Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding ScenarioTagOptions}"
                          SelectedItem="{Binding SelectedScenarioTag}"
                          Width="120"
                          Height="36"
                          Margin="0,0,10,0"/>
                <ui:TextBox PlaceholderText="{lex:Loc PlaceholderSearchTemplates}" 
                           Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                           Height="36"
                           MinWidth="250"
                           Margin="0,0,10,0"/>
            </StackPanel>

            <ui:Button Grid.Column="1" 
                  Content="{lex:Loc Back}" 
                  Icon="{ui:SymbolIcon Symbol=ArrowLeft20}"
                  Command="{Binding GoBackCommand}"/>
        </Grid>

        <ui:Card Grid.Row="1" Margin="0,0,16,12" Padding="12">
            <StackPanel>
                <TextBlock Text="{lex:Loc AddSource}" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox Width="130" SelectedValue="{Binding MarketplaceSourceKind}" SelectedValuePath="Tag"><ComboBoxItem Tag="Remote" Content="{lex:Loc MarketplaceRemoteSource}"/><ComboBoxItem Tag="UserLocal" Content="{lex:Loc MarketplaceUserLocalSource}"/></ComboBox>
                    <ui:TextBox Width="230" PlaceholderText="{lex:Loc MarketplaceSourcePlaceholder}" Text="{Binding MarketplaceSourceUrl, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/>
                    <ui:Button Content="{lex:Loc AddSource}" Command="{Binding AddMarketplaceSourceCommand}" Margin="8,0,0,0"/>
                    <ui:Button Content="{lex:Loc Refresh}" Command="{Binding LoadMarketplaceCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding MarketplaceStatus}" Margin="0,6,0,0"/>
                <ListBox ItemsSource="{Binding MarketplaceSources}" SelectedItem="{Binding SelectedMarketplaceSource}" Margin="0,6,0,0">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="{Binding Url}" Width="260" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Kind}" Width="70"/><TextBlock Text="{Binding PublisherFingerprint}" Width="100" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding IsEnabled}" Width="55"/><ui:Button Content="{lex:Loc MarketplaceDownload}" Command="{Binding DataContext.DownloadMarketplaceArtifactCommand, RelativeSource={RelativeSource AncestorType=Page}}" Margin="6,0,0,0"/><ui:Button Content="{lex:Loc MarketplaceEnable}" Command="{Binding DataContext.SetMarketplaceSourceEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="True" Margin="6,0,0,0"/><ui:Button Content="{lex:Loc MarketplaceDisable}" Command="{Binding DataContext.SetMarketplaceSourceEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="False" Margin="6,0,0,0"/><ui:Button Content="{lex:Loc MarketplaceRemove}" Command="{Binding DataContext.RemoveMarketplaceSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}" Margin="6,0,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <ui:TextBox PlaceholderText="{lex:Loc Search}" Text="{Binding MarketplaceSearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                <ListBox ItemsSource="{Binding MarketplaceEntries}" SelectedItem="{Binding SelectedMarketplaceEntry}" Margin="0,6,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Width="180"/><TextBlock Text="{Binding Version}" Width="90"/><TextBlock Text="{Binding ManifestDigest}" Width="140" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><ui:Button Content="{lex:Loc MarketplaceReview}" Command="{Binding ReviewMarketplaceUpdateCommand}"/><ui:Button Content="{lex:Loc MarketplaceApprove}" Command="{Binding ApproveMarketplaceCandidateCommand}" Margin="8,0,0,0"/><ui:Button Content="{lex:Loc MarketplaceRollback}" Command="{Binding RollbackMarketplaceArtifactCommand}" Margin="8,0,0,0"/></StackPanel>
                <ListBox ItemsSource="{Binding MarketplaceArtifactHistory}" SelectedItem="{Binding SelectedMarketplaceArtifact}" Margin="0,6,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Version}" Width="90"/><TextBlock Text="{Binding ArtifactSha256}" Width="360" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RecordedAt}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <StackPanel Margin="0,6,0,0" DataContext="{Binding SelectedMarketplaceEntry}">
                    <TextBlock Text="{lex:Loc MarketplaceDetails}" FontWeight="SemiBold"/>
                    <TextBlock><Run Text="{lex:Loc MarketplaceVersion}"/><Run Text=": "/><Run Text="{Binding Version}"/></TextBlock>
                    <TextBlock Text="{Binding TemplateId}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock><Run Text="{lex:Loc MarketplaceChecksum}"/><Run Text=": "/><Run Text="{Binding ManifestDigest}"/></TextBlock>
                    <TextBlock><Run Text="{lex:Loc MarketplaceSignature}"/><Run Text=": "/><Run Text="{Binding TrustState}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceSignatureStatus}"/><Run Text=": "/><Run Text="{Binding MarketplaceSignatureVerificationDisplay}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceTrustState}"/><Run Text=": "/><Run Text="{Binding MarketplaceTrustStateDisplay}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceCapabilities}"/><Run Text=": "/><Run Text="{Binding MarketplaceCapabilitiesDisplay}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceScripts}"/><Run Text=": "/><Run Text="{Binding MarketplaceScriptsDisplay}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceCompatibility}"/><Run Text=": "/><Run Text="{Binding MarketplaceCompatibilityDisplay}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceHealth}"/><Run Text=": "/><Run Text="{Binding MarketplaceHealthDisplay}"/></TextBlock>
                </StackPanel>
                <StackPanel Margin="0,6,0,0" DataContext="{Binding MarketplaceScriptDiff}">
                    <TextBlock Text="{lex:Loc MarketplaceScriptDiff}" FontWeight="SemiBold"/>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceDiffAdded}"/><Run Text=": "/><Run Text="{Binding MarketplaceDiffAddedDisplay}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceDiffRemoved}"/><Run Text=": "/><Run Text="{Binding MarketplaceDiffRemovedDisplay}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"><Run Text="{lex:Loc MarketplaceDiffChanged}"/><Run Text=": "/><Run Text="{Binding MarketplaceDiffChangedDisplay}"/></TextBlock>
                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}" Text="{Binding MarketplaceDiffTextDisplay}" TextWrapping="Wrap" MaxHeight="180" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel DataContext="{Binding SelectedMarketplaceSource}">
                    <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock><Run Text="{lex:Loc MarketplaceUpdated}"/><Run Text=": "/><Run Text="{Binding LastFetchedAt}"/></TextBlock>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Template List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,10" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <ui:SymbolIcon Grid.Column="0" 
                                              Symbol="{Binding Icon}" 
                                              FontSize="32"
                                              Margin="0,0,15,0"
                                              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" 
                                                  FontSize="16" 
                                                  FontWeight="SemiBold"/>
                                        <ui:Badge Content="{lex:Loc BadgeOfficial}" 
                                                 Appearance="Success" 
                                                 Margin="10,0,0,0"
                                                 Visibility="{Binding IsOfficial, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ui:Badge Content="{lex:Loc BadgeCustom}" 
                                                 Appearance="Caution" 
                                                 Margin="10,0,0,0"
                                                 Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="{Binding Description}" 
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Margin="0,4,0,0"
                                              TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Category}" 
                                                  FontSize="12" 
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text=" • " 
                                                  FontSize="12" 
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{Binding Version}" 
                                                  FontSize="12" 
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                         <TextBlock Text=" • " 
                                                  FontSize="12" 
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="{Binding Author}" 
                                                  FontSize="12" 
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SourceUrl}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PublisherFingerprint}"/>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                     <ui:Button Content="{lex:Loc ActionInstall}" 
                                               Icon="{ui:SymbolIcon Symbol=Add20}"
                                               Command="{Binding DataContext.InstallNewInstanceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"
                                               AutomationProperties.AutomationId="TemplateInstallButton"
                                               Appearance="Success"
                                               Margin="0,0,5,0"/>

                                     <ui:DropDownButton Content="{lex:Loc InstanceMore}" 
                                                        Icon="{ui:SymbolIcon Symbol=MoreHorizontal20}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                                        <ui:DropDownButton.Flyout>
                                            <ContextMenu>
                                                <ui:MenuItem Header="{lex:Loc ActionApply}"
                                                            Icon="{ui:SymbolIcon Symbol=Play20}"
                                                            Command="{Binding PlacementTarget.Tag.ApplyToInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <ui:MenuItem Header="{lex:Loc ActionExport}"
                                                            Icon="{ui:SymbolIcon Symbol=ArrowExport20}"
                                                            Command="{Binding PlacementTarget.Tag.ExportTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <ui:MenuItem Header="{lex:Loc ActionRemove}"
                                                            Icon="{ui:SymbolIcon Symbol=Delete20}"
                                                            Command="{Binding PlacementTarget.Tag.RemoveTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Visibility="{Binding PlacementTarget.DataContext.IsCustom, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </ContextMenu>
                                        </ui:DropDownButton.Flyout>
                                     </ui:DropDownButton>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Page>
