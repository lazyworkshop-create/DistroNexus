<Page x:Class="DistroNexus.Desktop.Views.UsbDevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lex="http://wpflocalizeextension.codeplex.com"
      lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
      lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources">
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,4"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <ui:Button Content="{lex:Loc Devices_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="{Binding SelectedGuidance}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <ListView ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
      <ListView.View><GridView><GridViewColumn Header="{lex:Loc Devices_BusIdHeader}" DisplayMemberBinding="{Binding BusId}" Width="90"/><GridViewColumn Header="{lex:Loc Devices_DescriptionHeader}" DisplayMemberBinding="{Binding Description}" Width="300"/><GridViewColumn Header="{lex:Loc Devices_StateHeader}" DisplayMemberBinding="{Binding Availability}" Width="100"/><GridViewColumn Header="{lex:Loc Devices_AttachmentHeader}" DisplayMemberBinding="{Binding Distribution}" Width="160"/></GridView></ListView.View>
    </ListView>
    </StackPanel>
  </Grid>
</Page>
