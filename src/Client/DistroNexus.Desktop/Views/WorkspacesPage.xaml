<Page x:Class="DistroNexus.Desktop.Views.WorkspacesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lex="http://wpflocalizeextension.codeplex.com"
      lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
      lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{lex:Loc Workspace_Title}" />
            <TextBlock Text="{Binding Status}" AutomationProperties.Name="{lex:Loc Workspace_Status}" />
            <TextBlock Text="{Binding ProgressText}" AutomationProperties.Name="{lex:Loc Workspace_Progress}" />
            <TextBlock Text="{Binding ValidationError}" AutomationProperties.Name="{lex:Loc Workspace_Validation}" />

            <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                     DisplayMemberPath="DisplayName" AutomationProperties.Name="{lex:Loc Workspace_Title}" />
            <WrapPanel>
                <ui:Button Content="{lex:Loc Workspace_Refresh}" Command="{Binding RefreshCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Preview}" Command="{Binding PreviewLaunchCommand}" />
                <ui:Button Content="{lex:Loc Workspace_ApproveTrust}" Command="{Binding ApproveTrustCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Launch}" Command="{Binding LaunchCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Cancel}" Command="{Binding CancelCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Retry}" Command="{Binding RetryCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Close}" Command="{Binding CloseCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Shortcut}" Command="{Binding CreateShortcutCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Export}" Command="{Binding ExportCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Duplicate}" Command="{Binding DuplicateCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Remove}" Command="{Binding RemoveCommand}" />
            </WrapPanel>

            <TextBlock Text="{lex:Loc Workspace_Name}" />
            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_Name}" />
            <TextBlock Text="{lex:Loc Workspace_Instance}" />
            <TextBox Text="{Binding EditInstance, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_Instance}" />
            <WrapPanel>
                <ui:Button Content="{lex:Loc Workspace_Create}" Command="{Binding CreateCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Save}" Command="{Binding SaveCommand}" />
                <ui:Button Content="{lex:Loc Workspace_EditDefinition}" Command="{Binding LoadDefinitionEditorCommand}" />
                <ui:Button Content="{lex:Loc Workspace_SaveDefinition}" Command="{Binding SaveDefinitionEditorCommand}" />
            </WrapPanel>
            <TextBlock Text="{lex:Loc Workspace_FullDefinition}" />
            <TextBox Text="{Binding DefinitionContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="100" AutomationProperties.Name="{lex:Loc Workspace_FullDefinition}" />

            <TextBlock Text="{lex:Loc Workspace_ImportContent}" />
            <TextBox Text="{Binding ImportContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="80" AutomationProperties.Name="{lex:Loc Workspace_ImportContent}" />
            <WrapPanel>
                <ui:Button Content="{lex:Loc Workspace_Preview}" Command="{Binding PreviewImportCommand}" />
                <ui:Button Content="{lex:Loc Workspace_Import}" Command="{Binding ImportCommand}" />
            </WrapPanel>
            <TextBox Text="{Binding Preview}" IsReadOnly="True" AcceptsReturn="True" MinHeight="60" AutomationProperties.Name="{lex:Loc Workspace_Preview}" />

            <TextBlock Text="{lex:Loc Workspace_StructuredEditor}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="220">
                    <TextBlock Text="{lex:Loc Workspace_Groups}" />
                    <ListBox ItemsSource="{Binding EditingDefinition.ActionGroups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" AutomationProperties.Name="{lex:Loc Workspace_Groups}" />
                    <WrapPanel>
                        <ui:Button Content="{lex:Loc Workspace_Add}" Command="{Binding AddGroupCommand}" />
                        <ui:Button Content="{lex:Loc Workspace_RemoveItem}" Command="{Binding RemoveGroupCommand}" />
                        <ui:Button Content="{lex:Loc Workspace_MoveUp}" Command="{Binding MoveGroupUpCommand}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Width="220" Margin="12,0,0,0">
                    <TextBlock Text="{lex:Loc Workspace_Actions}" />
                    <ListBox ItemsSource="{Binding SelectedGroup.Actions}" SelectedItem="{Binding SelectedAction}" DisplayMemberPath="Name" AutomationProperties.Name="{lex:Loc Workspace_Actions}" />
                    <WrapPanel>
                        <ui:Button Content="{lex:Loc Workspace_Add}" Command="{Binding AddActionCommand}" />
                        <ui:Button Content="{lex:Loc Workspace_RemoveItem}" Command="{Binding RemoveActionCommand}" />
                        <ui:Button Content="{lex:Loc Workspace_MoveUp}" Command="{Binding MoveActionUpCommand}" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
            <CheckBox Content="{lex:Loc Workspace_Parallel}" IsChecked="{Binding GroupAllowParallel}" AutomationProperties.Name="{lex:Loc Workspace_Parallel}" />
            <TextBlock Text="{lex:Loc Workspace_ActionName}" /><TextBox Text="{Binding ActionName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_ActionName}" />
            <TextBlock Text="{lex:Loc Workspace_ActionType}" /><ComboBox ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding ActionType}" AutomationProperties.Name="{lex:Loc Workspace_ActionType}" />
            <TextBlock Text="{lex:Loc Workspace_ActionArguments}" /><TextBox Text="{Binding ActionArguments, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_ActionArguments}" />
            <TextBlock Text="{lex:Loc Workspace_ActionDependencies}" /><TextBox Text="{Binding ActionDependencies, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_ActionDependencies}" />
            <TextBlock Text="{lex:Loc Workspace_ActionTimeout}" /><TextBox Text="{Binding ActionTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_ActionTimeout}" />
            <TextBlock Text="{lex:Loc Workspace_ActionFailurePolicy}" /><ComboBox ItemsSource="{Binding FailurePolicies}" SelectedItem="{Binding ActionFailurePolicy}" AutomationProperties.Name="{lex:Loc Workspace_ActionFailurePolicy}" />
            <ui:Button Content="{lex:Loc Workspace_Apply}" Command="{Binding ApplyActionCommand}" />

            <TextBlock Text="{lex:Loc Workspace_ProjectPath}" /><TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_ProjectPath}" />
            <TextBlock Text="{lex:Loc Workspace_MissingRemediation}" /><ComboBox ItemsSource="{Binding MissingRemediations}" SelectedItem="{Binding MissingInstanceRemediation}" AutomationProperties.Name="{lex:Loc Workspace_MissingRemediation}" />
            <TextBlock Text="{lex:Loc Workspace_CloseMode}" /><ComboBox ItemsSource="{Binding CloseModes}" SelectedItem="{Binding CloseMode}" AutomationProperties.Name="{lex:Loc Workspace_CloseMode}" />
            <TextBlock Text="{lex:Loc Workspace_CloseServices}" /><TextBox Text="{Binding CloseServices, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_CloseServices}" />
            <TextBlock Text="{lex:Loc Workspace_PreflightKind}" /><TextBox Text="{Binding PreflightKind, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_PreflightKind}" />
            <TextBlock Text="{lex:Loc Workspace_PreflightValue}" /><TextBox Text="{Binding PreflightValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{lex:Loc Workspace_PreflightValue}" />
            <CheckBox Content="{lex:Loc Workspace_Required}" IsChecked="{Binding PreflightRequired}" AutomationProperties.Name="{lex:Loc Workspace_Required}" />
            <ui:Button Content="{lex:Loc Workspace_AddPreflight}" Command="{Binding AddPreflightCommand}" />
            <ListBox ItemsSource="{Binding EditingDefinition.PreflightChecks}" AutomationProperties.Name="{lex:Loc Workspace_Preflights}">
                <ListBox.ItemTemplate>
                    <DataTemplate><WrapPanel><TextBlock Text="{Binding Kind}" /><TextBlock Text="{Binding Value}" Margin="6,0" /><ui:Button Content="{lex:Loc Workspace_RemoveItem}" Command="{Binding DataContext.RemovePreflightCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" /></WrapPanel></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ui:Button Content="{lex:Loc Workspace_SaveDefinition}" Command="{Binding SaveStructuredEditorCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
