<UserControl x:Class="DistroNexus.Desktop.Wizard.Steps.InstallPathStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DistroNexus.Desktop.Wizard.Steps"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:InstallPathStep}">
    
    <StackPanel>
        <!-- Instance Name -->
        <TextBlock Text="Instance Name:"
                   FontSize="14"
                   Margin="0,0,0,8"/>
        <ui:TextBox Text="{Binding Context.InstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Enter a name for this instance"
                   Margin="0,0,0,20"/>
        
        <!-- Installation Path -->
        <TextBlock Text="Installation Path:"
                   FontSize="14"
                   Margin="0,0,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <ui:TextBox Grid.Column="0"
                       Text="{Binding Context.InstallPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="Select installation directory"
                       Margin="0,0,10,0"/>
            
            <ui:Button Grid.Column="1"
                      Content="Browse..."
                      Command="{Binding BrowseCommand}"/>
        </Grid>
        
        <!-- Path Validation Message -->
        <Border Margin="0,15,0,0"
                Padding="12"
                CornerRadius="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="{Binding ValidationIcon}"
                              Foreground="{Binding ValidationColor}"
                              Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Context.PathValidationMessage}"
                          TextWrapping="Wrap"
                          Foreground="{Binding ValidationColor}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
