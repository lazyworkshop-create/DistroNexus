<UserControl x:Class="DistroNexus.Desktop.Wizard.Steps.ReviewStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DistroNexus.Desktop.Wizard.Steps"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:ReviewStep}">
    
    <Grid>
        <ui:Card Padding="16">
            <StackPanel>
                <TextBlock Text="{lex:Loc InstallationSummaryTitle}"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{lex:Loc LabelDistribution}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Context.SelectedDistribution.Name}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{lex:Loc LabelInstanceName}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Context.InstanceName}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{lex:Loc LabelInstallPath}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding FullInstallPath}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="{lex:Loc LabelUsername}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding DisplayUsername}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="{lex:Loc LabelWslVersion}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="{Binding WslVersionDisplayText}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="5" Grid.Column="0"
                               Text="{lex:Loc LabelTemplateName}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="{Binding TemplateNameDisplay}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Text="{lex:Loc LabelTemplateCategory}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Text="{Binding TemplateCategoryDisplay}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="7" Grid.Column="0"
                               Text="{lex:Loc LabelTemplateDescriptor}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="7" Grid.Column="1"
                               Text="{Binding TemplateDescriptorDisplay}"
                               FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
