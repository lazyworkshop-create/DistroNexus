<UserControl x:Class="DistroNexus.Desktop.Wizard.Steps.ReviewStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DistroNexus.Desktop.Wizard.Steps"
             xmlns:properties="clr-namespace:DistroNexus.Desktop.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:ReviewStep}">
    
    <StackPanel>
        <!-- Installation Summary Card -->
        <ui:Card Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.InstallationSummaryTitle}"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Distribution -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                              Text="{x:Static properties:Resources.LabelDistribution}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                              Text="{Binding Context.SelectedDistribution.Name}"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8"/>
                    
                    <!-- Instance Name -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                              Text="{x:Static properties:Resources.LabelInstanceName}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                              Text="{Binding Context.InstanceName}"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8"/>
                    
                    <!-- Install Path -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                              Text="{x:Static properties:Resources.LabelInstallPath}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                              Text="{Binding FullInstallPath}"
                              FontWeight="SemiBold"
                              TextTrimming="CharacterEllipsis"
                              Margin="0,0,0,8"/>
                    
                    <!-- Username -->
                    <TextBlock Grid.Row="3" Grid.Column="0" 
                              Text="{x:Static properties:Resources.LabelUsername}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" 
                              Text="{Binding DisplayUsername}"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8"/>
                    
                    <!-- WSL Version -->
                    <TextBlock Grid.Row="4" Grid.Column="0" 
                              Text="{x:Static properties:Resources.LabelWslVersion}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" 
                              Text="{Binding Context.WslVersion, StringFormat={x:Static properties:Resources.WslVersionFormat}}"
                              FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </ui:Card>
        
        <!-- Options -->
        <ui:ToggleSwitch Content="{x:Static properties:Resources.OptionSetDefault}"
                        IsChecked="{Binding Context.SetAsDefault, Mode=TwoWay}"
                        Margin="0,0,0,10"/>
        
        <ui:ToggleSwitch Content="{x:Static properties:Resources.OptionLaunchAfter}"
                        IsChecked="{Binding Context.LaunchAfterInstall, Mode=TwoWay}"/>
    </StackPanel>
</UserControl>
