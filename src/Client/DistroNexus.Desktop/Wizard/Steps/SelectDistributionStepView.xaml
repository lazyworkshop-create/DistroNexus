<UserControl x:Class="DistroNexus.Desktop.Wizard.Steps.SelectDistributionStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DistroNexus.Desktop.Wizard.Steps"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:SelectDistributionStep}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="{lex:Loc SelectDistroHeader}"
                   FontSize="14"
                   Margin="0,0,0,15"/>
        
        <!-- Distribution List -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding AvailableDistributions}"
                 SelectedItem="{Binding Context.SelectedDistribution, Mode=TwoWay}"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Icon placeholder -->
                        <Border Grid.Column="0" 
                                Width="40" Height="40" 
                                CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ui:SymbolIcon Symbol="Apps24" 
                                          FontSize="20"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        
                        <!-- Distribution Info -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" 
                                      FontSize="12"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <!-- Version -->
                        <TextBlock Grid.Column="2" 
                                  Text="{Binding Version}"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
