<UserControl x:Class="DistroNexus.Desktop.Wizard.Steps.SelectTemplateStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Template List -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:ToggleSwitch Grid.Column="0"
                                 VerticalAlignment="Center"
                                 Content="{lex:Loc UseTemplateSetup}"
                                 IsChecked="{Binding UseTemplate, Mode=TwoWay}"/>

                <ui:TextBox Grid.Column="2"
                            PlaceholderText="{lex:Loc PlaceholderSearchTemplates}"
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding UseTemplate}"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,10,10"
                        IsEnabled="{Binding UseTemplate}">
                <ComboBox Width="130" Margin="0,0,8,0"
                          ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory}"/>
                <ComboBox Width="150"
                          ItemsSource="{Binding ScenarioTagOptions}"
                          SelectedItem="{Binding SelectedScenarioTag}"/>
            </StackPanel>

            <ListView Grid.Row="2" ItemsSource="{Binding Templates}" 
                      SelectedItem="{Binding SelectedTemplate}"
                      SelectionMode="Single"
                      IsEnabled="{Binding UseTemplate}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
             <!-- Loading Indicator -->
             <ProgressBar Grid.Row="2" IsIndeterminate="True" 
                          VerticalAlignment="Top" 
                          Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        </Grid>

        <!-- Details -->
        <ScrollViewer Grid.Column="1" Margin="10,0,0,0">
            <Grid>
                 <!-- Fallback text if nothing selected (using data triggers locally to avoid assuming specific converters exist) -->
                 <TextBlock Text="{lex:Loc SelectTemplateEmptyState}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTemplate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                 </TextBlock>
                            
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTemplate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                     <TextBlock Text="{Binding SelectedTemplate.Name}" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                     <TextBlock Text="{Binding SelectedTemplate.Category}" Margin="0,0,0,10"/>
                     
                     <TextBlock Text="{lex:Loc LabelDescription}" FontWeight="SemiBold" Margin="0,10,0,5"/>
                     <TextBlock Text="{Binding SelectedTemplate.Description}" TextWrapping="Wrap"/>
                     
                     <TextBlock Text="{lex:Loc TemplateIncludedSoftware}" FontWeight="SemiBold" Margin="0,15,0,5"/>
                     <ItemsControl ItemsSource="{Binding SelectedTemplate.Packages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#11000000" CornerRadius="4" Padding="5,2" Margin="0,2">
                                     <StackPanel Orientation="Horizontal">
                                         <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                         <TextBlock Text="{Binding Version, StringFormat=' ({0})'}" Opacity="0.7"/>
                                     </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                     </ItemsControl>

                     <TextBlock Margin="0,15,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{lex:Loc TemplateAdvancedOptions}"/>

                     <ItemsControl ItemsSource="{Binding SelectedTemplate.PreflightChecks}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Opacity="0.85"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                     </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
