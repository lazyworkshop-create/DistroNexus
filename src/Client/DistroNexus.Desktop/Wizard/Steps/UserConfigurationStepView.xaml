<UserControl x:Class="DistroNexus.Desktop.Wizard.Steps.UserConfigurationStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DistroNexus.Desktop.Wizard.Steps"
             xmlns:properties="clr-namespace:DistroNexus.Desktop.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:UserConfigurationStep}">
    
    <StackPanel>
        <!-- Create User Toggle -->
        <ui:ToggleSwitch Content="{x:Static properties:Resources.CreateUserAccount}"
                        IsChecked="{Binding Context.CreateUser, Mode=TwoWay}"
                        Margin="0,0,0,20"/>
        
        <!-- User Configuration Panel -->
        <StackPanel IsEnabled="{Binding Context.CreateUser}">
            <!-- Username -->
            <TextBlock Text="{x:Static properties:Resources.LabelUsername}"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <ui:TextBox Text="{Binding Context.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{x:Static properties:Resources.PlaceholderUsername}"
                       Margin="0,0,0,15"/>
            
            <!-- Password -->
            <TextBlock Text="{x:Static properties:Resources.LabelPassword}"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <ui:PasswordBox Password="{Binding Context.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{x:Static properties:Resources.PlaceholderPassword}"
                           Margin="0,0,0,15"/>
            
            <!-- Confirm Password -->
            <TextBlock Text="{x:Static properties:Resources.LabelConfirmPassword}"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <ui:PasswordBox Password="{Binding Context.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{x:Static properties:Resources.PlaceholderConfirmPassword}"
                           Margin="0,0,0,15"/>
        </StackPanel>
        
        <!-- WSL Version -->
        <TextBlock Text="{x:Static properties:Resources.LabelWslVersion}"
                   FontSize="14"
                   Margin="0,10,0,8"/>
        <ComboBox SelectedIndex="{Binding WslVersionIndex, Mode=TwoWay}"
                  Width="150"
                  HorizontalAlignment="Left">
            <ComboBoxItem Content="{x:Static properties:Resources.WslVersion1}"/>
            <ComboBoxItem Content="{x:Static properties:Resources.WslVersion2}"/>
        </ComboBox>
        
        <!-- Info Text -->
        <Border Margin="0,20,0,0"
                Padding="12"
                CornerRadius="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Margin="0,0,10,0"/>
                <TextBlock Text="{x:Static properties:Resources.RootUserWarning}"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
