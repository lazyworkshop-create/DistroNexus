<UserControl x:Class="DistroNexus.Desktop.Wizard.Steps.UserConfigurationStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DistroNexus.Desktop"
             lex:ResxLocalizationProvider.DefaultDictionary="Properties.Resources"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DistroNexus.Desktop.Wizard.Steps"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:UserConfigurationStep}">
    
    <StackPanel>
        <!-- Create User Toggle -->
        <ui:ToggleSwitch Content="{lex:Loc CreateUserAccount}"
                        IsChecked="{Binding Context.CreateUser, Mode=TwoWay}"
                        Margin="0,0,0,20"/>
        
        <!-- User Configuration Panel -->
        <StackPanel IsEnabled="{Binding Context.CreateUser}">
            <!-- Username -->
            <TextBlock Text="{lex:Loc LabelUsername}"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <ui:TextBox Text="{Binding Context.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{lex:Loc PlaceholderUsername}"
                       Margin="0,0,0,15"/>
            
            <!-- Password -->
            <TextBlock Text="{lex:Loc LabelPassword}"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <PasswordBox x:Name="PasswordInput" Margin="0,0,0,15"/>
            
            <!-- Confirm Password -->
            <TextBlock Text="{lex:Loc LabelConfirmPassword}"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Margin="0,0,0,15"/>
        </StackPanel>
        
        <!-- WSL Version -->
        <TextBlock Text="{lex:Loc LabelWslVersion}"
                   FontSize="14"
                   Margin="0,10,0,8"/>
        <ComboBox SelectedIndex="{Binding WslVersionIndex, Mode=TwoWay}"
                  Width="150"
                  HorizontalAlignment="Left">
            <ComboBoxItem Content="{lex:Loc WslVersion1}"/>
            <ComboBoxItem Content="{lex:Loc WslVersion2}"/>
        </ComboBox>
        
        <!-- Info Text -->
        <Border Margin="0,20,0,0"
                Padding="12"
                CornerRadius="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Margin="0,0,10,0"/>
                <TextBlock Text="{lex:Loc RootUserWarning}"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
